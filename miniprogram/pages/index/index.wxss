/* pages/index/index.wxss */
.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 轮播图 */
.banner-swiper {
  width: 100%;
  height: 400rpx;
  position: relative;
  margin-bottom: 20rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.7));
  padding: 60rpx 30rpx 30rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
}

.banner-title {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}

.banner-subtitle {
  color: rgba(255,255,255,0.9);
  font-size: 26rpx;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.5);
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  background: white;
  padding: 40rpx 0;
  margin-bottom: 20rpx;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.action-title {
  font-size: 28rpx;
  color: #333;
}

/* 通用区块 */
.section {
  background: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 28rpx;
  color: #1890ff;
}

/* 门店列表 */
.store-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.store-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 16rpx;
}

.store-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.store-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.store-address {
  font-size: 26rpx;
  color: #666;
}

.store-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.store-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.distance {
  font-size: 24rpx;
  color: #999;
}

.book-btn {
  background: #1890ff;
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}

/* 服务特色 */
.features {
  display: flex;
  justify-content: space-between;
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #666;
}