page { background: #f8faf9; }
.order-detail-page { min-height: 100vh; padding: 76rpx 20rpx 150rpx; box-sizing: border-box; background: #f8faf9; }
.custom-nav { position: relative; height: 60rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; }
.nav-back { position: absolute; left: 0; top: 0; width: 54rpx; height: 60rpx; color: #111; font-size: 54rpx; line-height: 54rpx; }
.nav-title { color: #111; font-size: 32rpx; font-weight: 800; }
.status-card, .room-card, .info-card, .price-card, .notice-card, .entry-card { border-radius: 18rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(22,48,34,.06); }
.status-card { display: flex; padding: 28rpx 30rpx; margin-bottom: 16rpx; }
.status-icon { width: 84rpx; height: 84rpx; border-radius: 50%; background: #08A85C; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.status-icon image { width: 54rpx; height: 54rpx; filter: brightness(0) invert(1); }
.status-main { flex: 1; display: flex; flex-direction: column; }
.status-text { color: #08A85C; font-size: 38rpx; font-weight: 900; line-height: 1.1; }
.status-desc { margin-top: 8rpx; color: #3a443e; font-size: 25rpx; }
.countdown { margin-top: 10rpx; color: #08A85C; font-size: 31rpx; font-weight: 900; }
.open-tip { margin-top: 8rpx; color: #6a746e; font-size: 23rpx; }
.notice-strip { display: flex; align-items: center; min-height: 54rpx; padding: 0 18rpx; margin-bottom: 16rpx; border-radius: 10rpx; color: #168856; font-size: 23rpx; background: #eaf8f1; }
.notice-strip image { width: 28rpx; height: 28rpx; margin-right: 10rpx; }
.room-card { padding: 20rpx; margin-bottom: 16rpx; }
.room-main { display: flex; align-items: flex-start; width: 100%; min-width: 0; }
.room-img { width: 224rpx; height: 224rpx; border-radius: 12rpx; flex-shrink: 0; background: #edf0ee; }
.room-info { flex: 1; min-width: 0; padding-left: 22rpx; box-sizing: border-box; }
.store-row { display: flex; align-items: center; min-width: 0; margin-bottom: 12rpx; }
.store-name { flex: 1; min-width: 0; overflow: hidden; color: #111; font-size: 30rpx; font-weight: 900; line-height: 1.25; white-space: nowrap; text-overflow: ellipsis; }
.type-tag { flex-shrink: 0; margin-left: 12rpx; padding: 3rpx 9rpx; border-radius: 5rpx; color: #08A85C; font-size: 18rpx; background: #edf8f2; }
.kv { display: flex; align-items: flex-start; min-width: 0; margin-bottom: 9rpx; color: #28322c; font-size: 23rpx; line-height: 1.35; }
.kv-label { width: 112rpx; flex-shrink: 0; color: #747e78; }
.kv-value { flex: 1; min-width: 0; color: #28322c; text-align: left; word-break: break-all; }
.room-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 16rpx 0 0 246rpx; }
.room-tags text { padding: 5rpx 12rpx; border-radius: 6rpx; color: #08A85C; font-size: 20rpx; line-height: 1.2; background: #edf8f2; }
.address-line { display: flex; align-items: flex-start; margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid #edf0ee; color: #28322c; font-size: 23rpx; line-height: 1.45; }
.address-label { width: 80rpx; flex-shrink: 0; color: #747e78; }
.address-value { flex: 1; min-width: 0; word-break: break-all; }
.info-card, .price-card, .notice-card, .entry-card { padding: 22rpx 26rpx; margin-bottom: 16rpx; }
.info-row, .price-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; min-height: 48rpx; color: #222; font-size: 25rpx; }
.info-row > text:first-child, .price-row > text:first-child { flex-shrink: 0; color: #6f7a74; }
.info-row > text:last-child, .price-row > text:last-child { flex: 1; min-width: 0; text-align: right; word-break: break-all; }
.info-row view { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: flex-end; }
.info-row view text:first-child { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.copy { margin-left: 22rpx; color: #08A85C; font-size: 23rpx; }
.price-row.total { margin-top: 14rpx; padding-top: 16rpx; border-top: 1rpx solid #edf0ee; font-weight: 800; }
.price-row.total text:last-child { color: #e67c22; font-size: 34rpx; font-weight: 900; }
.discount { color: #e67c22; }
.section-title { display: block; margin-bottom: 12rpx; color: #151d18; font-size: 29rpx; font-weight: 900; }
.notice-card text { display: block; color: #4f5b54; font-size: 22rpx; line-height: 1.65; }
.entry-card { padding: 0 24rpx; overflow: hidden; }
.entry-item { display: flex; align-items: center; min-height: 92rpx; border-bottom: 1rpx solid #edf0ee; }
.entry-item:last-child { border-bottom: none; }
.entry-item image { width: 42rpx; height: 42rpx; margin-right: 18rpx; }
.entry-item view { flex: 1; display: flex; flex-direction: column; }
.entry-item view text:first-child { color: #151d18; font-size: 27rpx; font-weight: 800; }
.entry-item view text:last-child { margin-top: 6rpx; color: #7a837e; font-size: 21rpx; }
.arrow { color: #9ba39f; font-size: 42rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 14rpx; background: #fff; box-shadow: 0 -8rpx 24rpx rgba(20,43,31,.08); }
.pay-summary { flex: 1; min-width: 0; }
.pay-summary view { color: #222; font-size: 24rpx; }
.amount { margin-left: 8rpx; color: #e67c22; font-size: 34rpx; font-weight: 900; }
.pay-summary > text { display: block; max-width: 320rpx; overflow: hidden; color: #6f7a74; font-size: 21rpx; white-space: nowrap; text-overflow: ellipsis; }
.bottom-btn { height: 66rpx; margin: 0; padding: 0 28rpx; border-radius: 12rpx; font-size: 26rpx; line-height: 66rpx; }
.bottom-btn::after { border: none; }
.bottom-btn.ghost { color: #08A85C; border: 1rpx solid #08A85C; background: #fff; }
.bottom-btn.primary { color: #fff; background: #08A85C; }
.refund-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200; background: rgba(16, 24, 20, 0.56); }
.refund-modal { position: fixed; left: 42rpx; right: 42rpx; top: 50%; z-index: 201; transform: translateY(-50%); padding: 34rpx 32rpx 30rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 24rpx 60rpx rgba(9, 42, 25, 0.22); box-sizing: border-box; }
.refund-head { display: flex; align-items: center; margin-bottom: 28rpx; }
.refund-icon-wrap { width: 82rpx; height: 82rpx; margin-right: 20rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #eefaf4; flex-shrink: 0; }
.refund-icon-wrap image { width: 48rpx; height: 48rpx; }
.refund-title-wrap { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.refund-title { color: #151d18; font-size: 34rpx; font-weight: 900; line-height: 1.2; }
.refund-subtitle { max-width: 500rpx; margin-top: 8rpx; overflow: hidden; color: #7a837e; font-size: 23rpx; white-space: nowrap; text-overflow: ellipsis; }
.refund-summary { overflow: hidden; border-radius: 16rpx; border: 1rpx solid #edf0ee; background: #fbfdfc; }
.refund-summary-row { min-height: 72rpx; padding: 0 22rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf0ee; }
.refund-summary-row:last-child { border-bottom: none; }
.refund-label { color: #6f7a74; font-size: 25rpx; }
.refund-badge { padding: 6rpx 16rpx; border-radius: 999rpx; color: #08A85C; font-size: 23rpx; background: #edf8f2; }
.refund-summary-row.amount { min-height: 88rpx; background: linear-gradient(90deg, #fff 0%, #fffaf4 100%); }
.refund-amount { color: #e67c22; font-size: 42rpx; font-weight: 900; line-height: 1; }
.refund-policy { margin-top: 22rpx; padding: 18rpx 20rpx; border-radius: 14rpx; color: #3f6b55; font-size: 23rpx; line-height: 1.55; display: flex; align-items: flex-start; background: #effaf4; }
.refund-policy image { width: 32rpx; height: 32rpx; margin: 3rpx 12rpx 0 0; flex-shrink: 0; }
.reason-block { margin-top: 24rpx; }
.reason-title { display: block; color: #1e2923; font-size: 26rpx; font-weight: 800; margin-bottom: 14rpx; }
.reason-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.reason-chip { min-width: 144rpx; height: 54rpx; padding: 0 18rpx; border-radius: 999rpx; color: #5f6b65; font-size: 23rpx; line-height: 54rpx; text-align: center; background: #f4f6f5; border: 1rpx solid transparent; box-sizing: border-box; }
.reason-chip.active { color: #08A85C; border-color: #08A85C; background: #f3fbf7; font-weight: 800; }
.refund-actions { display: flex; gap: 18rpx; margin-top: 32rpx; }
.refund-cancel-btn, .refund-confirm-btn { width: 0; flex: 1; height: 78rpx; margin: 0; padding: 0; border-radius: 16rpx; font-size: 29rpx; font-weight: 800; line-height: 78rpx; }
.refund-cancel-btn::after, .refund-confirm-btn::after { border: none; }
.refund-cancel-btn { color: #303a34; background: #f4f6f5; }
.refund-confirm-btn { color: #fff; background: linear-gradient(135deg, #25bd70 0%, #08A85C 100%); box-shadow: 0 10rpx 22rpx rgba(8, 168, 92, 0.24); }
