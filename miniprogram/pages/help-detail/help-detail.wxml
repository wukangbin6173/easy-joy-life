<view class="page">
  <view class="nav"><view class="back" bindtap="goBack">‹</view><text class="title">帮助详情</text></view>
  <view class="article">
    <text class="article-title">{{detail.title}}</text>
    <text class="paragraph" wx:for="{{detail.paragraphs}}" wx:key="*this">{{item}}</text>
  </view>
  <view class="service" bindtap="contactService">
    <image src="/images/联系客服.png" mode="aspectFit"></image>
    <view><text>仍未解决？</text><text>联系在线客服获取帮助</text></view>
    <text class="arrow">›</text>
  </view>
</view>
<qx-dialog dialog="{{__qxDialog}}" bind:confirm="__onQxDialogConfirm" bind:cancel="__onQxDialogCancel" />
