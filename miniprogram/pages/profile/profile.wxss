page {
  background: #f8faf9;
}

.profile-page {
  min-height: 100vh;
  padding: 88rpx 20rpx 138rpx;
  box-sizing: border-box;
  background: #f8faf9;
}

.brand-row {
  display: flex;
  align-items: center;
  margin: 0 8rpx 28rpx;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  border: 3rpx solid #0a8a4d;
  border-radius: 50%;
  color: #0a8a4d;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.brand-text {
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
}

.brand-cn {
  color: #0a8a4d;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1;
}

.brand-en {
  margin-top: 7rpx;
  color: #0a8a4d;
  font-size: 15rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.user-card {
  position: relative;
  height: 210rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  background: linear-gradient(105deg, #f8fffb 0%, #eefaf4 48%, #dff6ea 100%);
  box-shadow: 0 10rpx 30rpx rgba(16, 82, 52, 0.08);
  box-sizing: border-box;
}

.avatar-wrap,
.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-wrap {
  position: relative;
  z-index: 2;
  overflow: hidden;
}

.avatar {
  display: block;
}

.avatar-default {
  background: #edf2ef;
}

.avatar-picker {
  position: absolute;
  left: 0;
  top: 0;
  width: 116rpx;
  height: 116rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  opacity: 0;
}

.avatar-picker::after {
  border: 0;
}

.user-main {
  position: relative;
  z-index: 2;
  min-width: 0;
  flex: 1;
  margin-left: 28rpx;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.nickname {
  max-width: 240rpx;
  overflow: hidden;
  color: #17211c;
  font-size: 36rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.set-avatar-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  margin: 0 0 0 16rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #09a85b;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 42rpx;
  flex-shrink: 0;
}

.set-avatar-btn::after {
  border: 0;
}

.phone-row {
  display: flex;
  align-items: center;
  color: #26352e;
  font-size: 25rpx;
  margin-bottom: 11rpx;
}

.verify-badge {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  color: #15965a;
  font-size: 22rpx;
}

.verify-badge image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}

.user-desc {
  color: #647069;
  font-size: 21rpx;
}

.user-card-bg {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 1;
}

.section-title {
  margin: 40rpx 10rpx 18rpx;
  color: #1a1f1c;
  font-size: 31rpx;
  font-weight: 800;
}

.booking-card {
  display: flex;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(20, 43, 31, 0.07);
}

.booking-img {
  width: 232rpx;
  height: 186rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.booking-info {
  min-width: 0;
  flex: 1;
  padding-left: 22rpx;
}

.booking-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.booking-store {
  max-width: 260rpx;
  overflow: hidden;
  color: #121a16;
  font-size: 29rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.booking-status {
  color: #08A85C;
  font-size: 23rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #edf8f2;
}

.booking-line {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  color: #3f4943;
  font-size: 25rpx;
}

.booking-line image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  opacity: 0.72;
}

.booking-actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 20rpx;
}

.booking-btn {
  min-width: 140rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 58rpx;
}

.booking-btn::after,
.support-btn::after {
  border: none;
}

.booking-btn.ghost {
  color: #2b3730;
  background: #fff;
  border: 1rpx solid #dce6e0;
}

.booking-btn.primary,
.support-btn {
  color: #fff;
  background: #08A85C;
}

.empty-booking {
  align-items: center;
}

.empty-booking-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  color: #0a8a4d;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 120rpx;
  text-align: center;
  background: #eef9f3;
}

.empty-booking-text {
  display: block;
  margin-top: 14rpx;
  color: #7b8580;
  font-size: 24rpx;
}

.service-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(20, 43, 31, 0.06);
}

.service-item {
  height: 88rpx;
  margin-left: 28rpx;
  padding-right: 26rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #edf0ee;
}

.service-item:last-child {
  border-bottom: none;
}

.service-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 26rpx;
}

.service-title {
  flex: 1;
  color: #26302a;
  font-size: 28rpx;
}

.service-arrow {
  color: #9ba39f;
  font-size: 44rpx;
  line-height: 1;
}

.support-card {
  height: 88rpx;
  margin-top: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  background: #eaf8f1;
}

.support-icon {
  width: 54rpx;
  height: 54rpx;
  margin-right: 18rpx;
}

.support-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.support-title {
  color: #26302a;
  font-size: 27rpx;
  font-weight: 700;
}

.support-desc {
  margin-top: 6rpx;
  color: #77847d;
  font-size: 21rpx;
}

.support-btn {
  width: 132rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 54rpx;
}
