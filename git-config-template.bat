@echo off
echo 请按照以下步骤配置Git用户信息：
echo.
echo 1. 设置用户名（替换为你的GitHub用户名）：
echo git config --global user.name "你的GitHub用户名"
echo.
echo 2. 设置邮箱（替换为你的GitHub邮箱）：
echo git config --global user.email "你的邮箱@example.com"
echo.
echo 3. 检查配置：
echo git config --global user.name
echo git config --global user.email
echo.
echo 配置完成后，请运行以下命令继续：
echo git add .
echo git commit -m "Initial commit: 雀胜无人棋牌室管理系统"
echo.
pause