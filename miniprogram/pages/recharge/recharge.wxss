.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 200rpx;
}

/* 余额信息 */
.balance-info {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.balance-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
}

/* 金额选择 */
.amount-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.amount-item {
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s;
}

.amount-item.selected {
  background: #e6f7ff;
  border-color: #1890ff;
}

.amount-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.amount-item.selected .amount-text {
  color: #1890ff;
}

/* 自定义金额 */
.custom-amount {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 30rpx;
}

.custom-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 20rpx;
}

.currency {
  font-size: 32rpx;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

/* 支付方式 */
.payment-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.payment-methods {
  display: flex;
  flex-direction: column;
}

.payment-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.payment-item:last-child {
  border-bottom: none;
}

.payment-item.selected {
  background: #f6ffed;
  margin: 0 -30rpx;
  padding: 30rpx;
  border-radius: 12rpx;
}

.payment-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 30rpx;
}

.payment-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.payment-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.payment-desc {
  font-size: 24rpx;
  color: #999;
}

.payment-radio {
  width: 40rpx;
  height: 40rpx;
}

.radio {
  width: 100%;
  height: 100%;
  border: 2rpx solid #d9d9d9;
  border-radius: 50%;
  position: relative;
}

.radio.checked {
  border-color: #52c41a;
  background: #52c41a;
}

.radio.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 12rpx;
  background: white;
  border-radius: 50%;
}

/* 优惠信息 */
.promotion-section {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.promotion-item {
  display: flex;
  align-items: center;
}

.promotion-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

.promotion-text {
  font-size: 28rpx;
  color: #fa8c16;
}

/* 充值说明 */
.notice-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.notice-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.notice-list {
  display: flex;
  flex-direction: column;
}

.notice-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

/* 充值按钮 */
.recharge-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.amount-summary {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.recharge-btn {
  width: 100%;
  height: 88rpx;
  background: #d9d9d9;
  color: #999;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recharge-btn.active {
  background: #1890ff;
  color: white;
}

.recharge-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}