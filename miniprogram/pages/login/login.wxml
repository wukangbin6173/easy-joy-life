<!--pages/login/login.wxml-->
<view class="container">
  <view class="login-box">
    <!-- Logo -->
    <view class="logo-section">
      <image class="logo" src="/images/logo.png" mode="aspectFit" />
      <text class="app-name">雀玺棋牌室</text>
      <text class="app-desc">完善个人信息，享受更多服务</text>
    </view>

    <!-- 登录按钮 -->
    <view class="login-section">
      <button 
        class="login-btn" 
        bindtap="onWechatLogin"
        loading="{{loading}}"
        disabled="{{loading}}">
        <image class="wechat-icon" src="/images/wechat-pay-icon.png" />
        完善个人信息
      </button>
      
      <view class="login-tips">
        <text>完善信息即表示同意</text>
        <text class="link">《用户协议》</text>
        <text>和</text>
        <text class="link">《隐私政策》</text>
      </view>
    </view>

    <!-- 特色介绍 -->
    <view class="features">
      <view class="feature-item">
        <image class="feature-icon" src="/images/feature-24h.png" />
        <text class="feature-text">24小时营业</text>
      </view>
      <view class="feature-item">
        <image class="feature-icon" src="/images/feature-smart.png" />
        <text class="feature-text">智能开门</text>
      </view>
      <view class="feature-item">
        <image class="feature-icon" src="/images/feature-clean.png" />
        <text class="feature-text">环境整洁</text>
      </view>
    </view>
  </view>
</view>
<qx-dialog dialog="{{__qxDialog}}" bind:confirm="__onQxDialogConfirm" bind:cancel="__onQxDialogCancel" />
