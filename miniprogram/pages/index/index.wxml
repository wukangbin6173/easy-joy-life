<!--首页 - 参照雀胜样式-->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <image class="search-icon" src="/images/search.png"></image>
    <input class="search-input" placeholder="请输入关键字" bindinput="onSearchInput" bindconfirm="onSearch" />
  </view>

  <!-- 品牌Banner -->
  <view class="brand-banner">
    <image class="brand-bg" src="/images/brand-banner.jpg" mode="aspectFill"></image>
    <view class="brand-overlay">
      <text class="brand-name">雀玺</text>
      <text class="brand-welcome">欢迎您</text>
    </view>
    <!-- 右上角图标 -->
    <view class="banner-icons">
      <view class="banner-icon-item" bindtap="goToOrders">
        <image src="/images/order.png" class="banner-icon-img"></image>
      </view>
    </view>
  </view>

  <!-- 门店列表 -->
  <view class="store-list">
    <view class="store-card" wx:for="{{nearbyStores}}" wx:key="id"
          bindtap="onStoreDetail" data-id="{{item.id}}" data-merchantid="{{item.merchantId}}">
      <image class="store-img" src="{{item.images ? item.images[0] : '/images/default-store.jpg'}}" mode="aspectFill"></image>
      <view class="store-info">
        <text class="store-name">{{item.name}}</text>
        <text class="store-address">{{item.address}}</text>
        <view class="store-meta">
          <text class="store-rooms">剩余{{item.availableRooms || 0}}间包厢</text>
          <text class="store-distance">{{item.distance || ''}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{nearbyStores.length === 0 && !loading}}">
      <text class="empty-text">暂无门店数据</text>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
