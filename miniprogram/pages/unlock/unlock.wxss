.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.unlock-header {
  background: white;
  border-radius: 10rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.lock-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.unlock-methods {
  background: white;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.method-item:last-child {
  border-bottom: none;
}

.method-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 30rpx;
}

.method-icon image {
  width: 100%;
  height: 100%;
}

.method-info {
  flex: 1;
}

.method-title {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.method-desc {
  font-size: 24rpx;
  color: #999;
}

.method-action {
  text-align: right;
}

.unlock-code {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
  letter-spacing: 5rpx;
}

.unlock-btn {
  background: #1890ff;
  color: white;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
}

.unlock-status {
  background: white;
  border-radius: 10rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
}

.status-icon {
  margin-bottom: 20rpx;
}

.status-icon image {
  width: 100rpx;
  height: 100rpx;
}

.status-text {
  font-size: 32rpx;
  color: #333;
}

.unlock-tips {
  background: white;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.tip-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-number {
  width: 40rpx;
  height: 40rpx;
  background: #1890ff;
  color: white;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 40rpx;
}

.contact-service {
  text-align: center;
}

.service-btn {
  width: 300rpx;
  height: 80rpx;
  background: #52c41a;
  color: white;
  border-radius: 40rpx;
  font-size: 28rpx;
}