page {
  background: #f8faf9;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 48rpx;
  background: #f8faf9;
}

.page-head {
  margin: 8rpx 0 22rpx;
}

.page-title {
  display: block;
  color: #151d18;
  font-size: 36rpx;
  font-weight: 800;
}

.page-count {
  display: block;
  margin-top: 8rpx;
  color: #7b8580;
  font-size: 24rpx;
}

.store-card {
  min-height: 150rpx;
  box-sizing: border-box;
  padding: 18rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(20, 43, 31, 0.06);
}

.store-img {
  width: 126rpx;
  height: 126rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #eef9f3;
}

.store-info {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.store-name {
  display: block;
  overflow: hidden;
  color: #1d2721;
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.store-address {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #707a75;
  font-size: 24rpx;
  line-height: 34rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.remove-btn {
  flex-shrink: 0;
  min-width: 116rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #08A85C;
  font-size: 23rpx;
  border: 1rpx solid #b9e8d2;
  background: #f3fbf7;
}

.empty-state {
  min-height: 560rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(20, 43, 31, 0.06);
}

.empty-icon {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 24rpx;
  opacity: 0.72;
}

.empty-text {
  color: #5f6964;
  font-size: 28rpx;
}

.empty-btn {
  width: 220rpx;
  height: 68rpx;
  margin-top: 30rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 68rpx;
  background: #08A85C;
}

.empty-btn::after {
  border: none;
}
