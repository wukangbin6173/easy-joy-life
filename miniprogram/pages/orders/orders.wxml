<!--订单页 - 雀胜风格-->
<view class="container">
  <!-- Tab栏 -->
  <view class="tabs">
    <view class="tab-item {{activeTab === 'ongoing' ? 'active' : ''}}" bindtap="switchTab" data-tab="ongoing">进行中</view>
    <view class="tab-item {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已完成</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="viewOrderDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-store">{{item.storeName}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>
      <view class="order-body">
        <text class="order-room">{{item.roomName}}</text>
        <text class="order-time">{{item.bookingDate}} {{item.startTime}}-{{item.endTime}}</text>
      </view>
      <view class="order-footer">
        <text class="order-price">¥{{item.totalPrice}}</text>
        <view class="order-actions">
          <button class="btn-cancel" wx:if="{{item.status === 'pending'}}" catchtap="cancelOrder" data-id="{{item.id}}">取消</button>
          <button class="btn-primary" wx:if="{{item.status === 'using'}}" catchtap="unlockRoom" data-id="{{item.id}}">开门</button>
          <button class="btn-default" wx:if="{{item.status === 'completed'}}" catchtap="rateOrder" data-id="{{item.id}}">评价</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{orders.length === 0}}">
    <image class="empty-icon" src="/images/empty-order.png"></image>
    <text class="empty-text">暂无充值数据</text>
  </view>
</view>
