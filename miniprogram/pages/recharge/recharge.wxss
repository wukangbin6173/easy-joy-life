/* 充值页 - 雀胜风格 */
.container { background: #f5f5f5; min-height: 100vh; padding-bottom: 160rpx; }

/* 余额积分卡片 */
.balance-card {
  display: flex; margin: 20rpx; background: linear-gradient(135deg, #4a90d9, #357abd);
  border-radius: 16rpx; padding: 40rpx; color: #fff;
}
.balance-item { flex: 1; text-align: center; }
.balance-label { display: block; font-size: 26rpx; opacity: 0.8; margin-bottom: 12rpx; }
.balance-value { font-size: 40rpx; font-weight: bold; }

/* 金额选择 */
.amount-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.section-title { display: block; font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 24rpx; }
.amount-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-bottom: 30rpx; }
.amount-item {
  background: #f5f5f5; border: 2rpx solid #e8e8e8; border-radius: 12rpx;
  padding: 28rpx; text-align: center;
}
.amount-item.selected { background: #e6f7ff; border-color: #1890ff; }
.amount-text { font-size: 32rpx; font-weight: bold; color: #333; }
.amount-item.selected .amount-text { color: #1890ff; }

.custom-amount { border-top: 1rpx solid #f0f0f0; padding-top: 24rpx; }
.custom-label { display: block; font-size: 26rpx; color: #666; margin-bottom: 16rpx; }
.input-wrapper {
  display: flex; align-items: center; background: #f5f5f5;
  border: 2rpx solid #e8e8e8; border-radius: 12rpx; padding: 16rpx 20rpx;
}
.currency { font-size: 32rpx; color: #333; margin-right: 8rpx; }
.amount-input { flex: 1; font-size: 32rpx; color: #333; }

/* 支付方式 */
.payment-section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx; }
.payment-item {
  display: flex; align-items: center; padding: 24rpx 0;
}
.payment-item.selected { }
.payment-icon { width: 60rpx; height: 60rpx; margin-right: 20rpx; }
.payment-name { flex: 1; font-size: 30rpx; color: #333; }
.radio {
  width: 40rpx; height: 40rpx; border: 2rpx solid #d9d9d9; border-radius: 50%;
  position: relative;
}
.radio.checked { border-color: #52c41a; background: #52c41a; }
.radio.checked::after {
  content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 14rpx; height: 14rpx; background: #fff; border-radius: 50%;
}

/* 充值按钮 */
.recharge-footer {
  position: fixed; bottom: 0; left: 0; right: 0; background: #fff;
  padding: 20rpx 30rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}
.recharge-btn {
  width: 100%; height: 88rpx; background: #d9d9d9; color: #999;
  border-radius: 44rpx; font-size: 32rpx; display: flex; align-items: center; justify-content: center;
}
.recharge-btn.active { background: #1890ff; color: #fff; }
