/* 订单页 - 雀胜风格 */
.container { background: #f5f5f5; min-height: 100vh; }

/* Tab栏 */
.tabs { display: flex; background: #fff; }
.tab-item {
  flex: 1; text-align: center; padding: 28rpx 0; font-size: 30rpx;
  color: #666; position: relative;
}
.tab-item.active { color: #1890ff; font-weight: bold; }
.tab-item.active::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 60rpx; height: 4rpx; background: #1890ff; border-radius: 2rpx;
}

/* 订单列表 */
.order-list { padding: 20rpx; }
.order-card {
  background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx;
}
.order-header {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx;
}
.order-store { font-size: 30rpx; font-weight: bold; color: #333; }
.order-status { font-size: 24rpx; color: #1890ff; }
.order-body { margin-bottom: 16rpx; }
.order-room { display: block; font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.order-time { font-size: 24rpx; color: #999; }
.order-footer { display: flex; justify-content: space-between; align-items: center; }
.order-price { font-size: 36rpx; font-weight: bold; color: #ff4d4f; }
.order-actions { display: flex; gap: 16rpx; }
.btn-cancel, .btn-default {
  padding: 10rpx 24rpx; font-size: 24rpx; border-radius: 24rpx;
  border: 1rpx solid #d9d9d9; background: #fff; color: #666;
}
.btn-primary {
  padding: 10rpx 24rpx; font-size: 24rpx; border-radius: 24rpx;
  background: #1890ff; color: #fff; border: none;
}

/* 空状态 */
.empty-state { text-align: center; padding: 200rpx 0; }
.empty-icon { width: 200rpx; height: 200rpx; margin-bottom: 24rpx; opacity: 0.5; }
.empty-text { font-size: 28rpx; color: #999; }
