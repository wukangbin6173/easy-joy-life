<view class="container profile-page">
  <view class="brand-row">
    <view class="brand-mark">雀</view>
    <view class="brand-text">
      <text class="brand-cn">雀玺</text>
      <text class="brand-en">QUE XI</text>
    </view>
  </view>

  <view class="user-card">
    <view class="avatar-wrap">
      <image class="avatar" wx:if="{{displayAvatar && !avatarLoadFailed}}" src="{{displayAvatar}}" mode="aspectFill" binderror="onAvatarError"></image>
      <image class="avatar avatar-default" wx:else src="/images/default-avatar.png" mode="aspectFill"></image>
      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" loading="{{savingAvatar}}" disabled="{{savingAvatar}}"></button>
    </view>
    <view class="user-main" bindtap="onAvatarTap">
      <view class="name-row">
        <text class="nickname">{{userInfo.nickname || '微信用户'}}</text>
        <button wx:if="{{!hasAvatar || avatarLoadFailed}}" class="set-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" catchtap="noop" loading="{{savingAvatar}}" disabled="{{savingAvatar}}">设置头像</button>
      </view>
      <view class="phone-row">
        <text>{{maskedPhone}}</text>
        <view class="verify-badge">
          <image src="/images/自助开门.png" mode="aspectFit"></image>
          <text>已认证</text>
        </view>
      </view>
      <text class="user-desc">已绑定手机号，可用于预约与到店校验</text>
    </view>
    <image class="user-card-bg" src="/images/我的banner背景.jpg" mode="aspectFill"></image>
  </view>

  <view class="section-title">当前预约</view>
  <view class="booking-card" wx:if="{{currentBooking}}">
    <image class="booking-img" src="{{currentBooking.image}}" mode="aspectFill"></image>
    <view class="booking-info">
      <view class="booking-head">
        <text class="booking-store">{{currentBooking.storeName}}</text>
        <text class="booking-status">{{currentBooking.statusText}}</text>
      </view>
      <view class="booking-line">
        <image src="/images/已选包间.png" mode="aspectFit"></image>
        <text>{{currentBooking.roomName}}</text>
      </view>
      <view class="booking-line">
        <image src="/images/时间.png" mode="aspectFit"></image>
        <text>{{currentBooking.timeText}}</text>
      </view>
      <view class="booking-actions">
        <button class="booking-btn ghost" bindtap="viewCurrentBookingOrder">查看订单</button>
        <button class="booking-btn primary" bindtap="navigateCurrentBooking">导航到店</button>
      </view>
    </view>
  </view>
  <view class="booking-card empty-booking" wx:else>
    <view class="empty-booking-icon">雀</view>
    <view class="booking-info">
      <text class="booking-store">暂无当前预约</text>
      <text class="empty-booking-text">预约棋牌、台球或洗车后会显示在这里</text>
      <view class="booking-actions">
        <button class="booking-btn primary" bindtap="goToHome">去预约</button>
      </view>
    </view>
  </view>

  <view class="section-title">常用服务</view>
  <view class="service-card">
    <view class="service-item" wx:for="{{serviceItems}}" wx:key="title" data-action="{{item.action}}" bindtap="onServiceTap">
      <image class="service-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <text class="service-title">{{item.title}}</text>
      <text class="service-arrow">›</text>
    </view>
  </view>

  <view class="support-card">
    <image class="support-icon" src="/images/联系客服.png" mode="aspectFit"></image>
    <view class="support-text">
      <text class="support-title">遇到问题，随时联系客服</text>
      <text class="support-desc">7×24小时在线客服</text>
    </view>
    <button class="support-btn" bindtap="contactService">联系客服</button>
  </view>
</view>
<qx-dialog dialog="{{__qxDialog}}" bind:confirm="__onQxDialogConfirm" bind:cancel="__onQxDialogCancel" />
