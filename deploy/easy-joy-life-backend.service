[Unit]
Description=Easy Joy Life Chess Room Management System - Backend Service
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/easy-joy-life/backend
ExecStart=/usr/bin/java -jar -Dspring.profiles.active=prod /opt/easy-joy-life/backend/target/easy-joy-life-system-1.0.0.jar
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=easy-joy-life-backend

# 环境变量
Environment="MYSQL_HOST=localhost"
Environment="MYSQL_PORT=3306"
Environment="MYSQL_DATABASE=easy_joy_life_db"
Environment="MYSQL_USER=root"
Environment="MYSQL_PASSWORD=EasyJoyLife2024!@#"
Environment="REDIS_HOST=localhost"
Environment="REDIS_PORT=6379"
Environment="JWT_SECRET=EasyJoyLife-JWT-Secret-Key-2024-Production-Very-Long-And-Secure-String"
Environment="WECHAT_APPID=your_wechat_miniprogram_appid"
Environment="WECHAT_SECRET=your_wechat_miniprogram_secret"
Environment="WECHAT_MCH_ID=your_wechat_merchant_id"
Environment="WECHAT_API_KEY=your_wechat_payment_api_key"
Environment="SERVER_DOMAIN=https://www.quexitai.com"

[Install]
WantedBy=multi-user.target
