{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "new_page",
        "list_pages",
        "list_console_messages",
        "list_network_requests",
        "take_screenshot",
        "take_snapshot",
        "get_network_request",
        "navigate_page",
        "click",
        "get_console_message",
        "evaluate_script",
        "press_key",
        "fill"
      ]
    },
    "github": {
      "command": "uvx",
      "args": [
        "mcp-server-github@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "get_repository",
        "list_repositories",
        "get_file_contents",
        "list_directory_contents",
        "search_repositories",
        "get_issues",
        "get_pull_requests"
      ]
    }
  }
}