<view class="page">
  <view class="nav"><view class="back" bindtap="goBack">‹</view><text class="title">帮助中心</text></view>
  <view class="search">搜索问题 / 预约 / 开门 / 支付</view>
  <view class="card">
    <view class="item" wx:for="{{helps}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <image src="{{item.icon}}" mode="aspectFit"></image>
      <view class="main">
        <text class="name">{{item.title}}</text>
        <text class="desc">{{item.desc}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
<qx-dialog dialog="{{__qxDialog}}" bind:confirm="__onQxDialogConfirm" bind:cancel="__onQxDialogCancel" />
