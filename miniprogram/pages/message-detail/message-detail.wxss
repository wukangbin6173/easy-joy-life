page { background: #f8faf9; }
.page { min-height: 100vh; padding: 76rpx 22rpx 40rpx; box-sizing: border-box; }
.nav { position: relative; height: 60rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.back { position: absolute; left: 0; top: 0; width: 54rpx; height: 60rpx; font-size: 54rpx; line-height: 54rpx; color: #111; }
.title { font-size: 32rpx; font-weight: 800; color: #111; }
.card { padding: 44rpx 34rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(22,48,34,.06); display: flex; flex-direction: column; align-items: center; }
.icon { width: 86rpx; height: 86rpx; margin-bottom: 22rpx; }
.msg-title { color: #151d18; font-size: 34rpx; font-weight: 900; }
.time { margin: 12rpx 0 34rpx; color: #9aa39e; font-size: 23rpx; }
.content { width: 100%; color: #4e5a54; font-size: 28rpx; line-height: 1.8; }
.primary { width: 100%; height: 78rpx; margin-top: 46rpx; border-radius: 14rpx; color: #fff; font-size: 29rpx; line-height: 78rpx; background: #08A85C; }
.primary::after { border: none; }
