.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: white;
  border-radius: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.test-section {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #F5A623;
  padding-left: 15rpx;
}

.test-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.test-item:last-child {
  border-bottom: none;
}

.test-name {
  font-size: 28rpx;
  color: #333;
  width: 200rpx;
}

.test-value {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  margin-right: 20rpx;
}

.test-status {
  font-size: 32rpx;
  font-weight: bold;
}

.test-status.success {
  color: #52c41a;
}

.test-status.error {
  color: #ff4d4f;
}

.test-button {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #F5A623;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.test-button:disabled {
  background: #d9d9d9;
  color: #999;
}

.test-result {
  font-size: 24rpx;
}

.test-result.success {
  color: #52c41a;
}

.test-result.error {
  color: #ff4d4f;
}

.test-result.pending {
  color: #faad14;
}

.amount-selector {
  display: flex;
  gap: 20rpx;
}

.amount-btn {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  background: #f0f0f0;
  color: #333;
  border: 2rpx solid #d9d9d9;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.amount-btn.selected {
  background: #F5A623;
  color: white;
  border-color: #F5A623;
}

.log-container {
  height: 300rpx;
  background: #f8f8f8;
  border: 1rpx solid #e8e8e8;
  border-radius: 6rpx;
  padding: 15rpx;
}

.log-item {
  margin-bottom: 10rpx;
  font-size: 24rpx;
}

.log-time {
  color: #999;
  margin-right: 15rpx;
}

.log-message {
  color: #333;
}

.clear-log-btn {
  width: 100%;
  height: 60rpx;
  line-height: 60rpx;
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #d9d9d9;
  border-radius: 6rpx;
  font-size: 26rpx;
  margin-top: 15rpx;
}