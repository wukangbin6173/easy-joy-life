.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.section {
  background-color: white;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.info {
  flex: 1;
}

.nickname {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.status {
  font-size: 24rpx;
  color: #666;
}

.no-info {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}

.auth-info {
  display: flex;
  flex-direction: column;
}

.auth-item {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.test-results {
  display: flex;
  flex-direction: column;
}

.test-item {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  padding: 10rpx;
  background-color: #f9f9f9;
  border-radius: 5rpx;
}

.actions {
  margin-top: 40rpx;
}

.action-btn {
  width: 100%;
  margin-bottom: 20rpx;
  background-color: #007aff;
  color: white;
  border-radius: 10rpx;
  font-size: 28rpx;
}