/* 订单页 */
page {
  background: #f7f8f7;
}

.order-page {
  min-height: 100vh;
  padding: 70rpx 18rpx 34rpx;
  box-sizing: border-box;
  background: #f8faf9;
}

.custom-nav {
  position: relative;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.nav-back {
  position: absolute;
  left: 0;
  top: 0;
  width: 52rpx;
  height: 58rpx;
  color: #1a1a1a;
  font-size: 54rpx;
  line-height: 52rpx;
  font-weight: 300;
}

.nav-title {
  color: #111;
  font-size: 31rpx;
  font-weight: 700;
}

.status-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 18rpx;
  margin-bottom: 18rpx;
}

.status-tab {
  min-width: 104rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #202722;
  font-size: 25rpx;
  line-height: 52rpx;
  text-align: center;
  background: #fff;
  box-sizing: border-box;
}

.status-tab.active {
  color: #fff;
  font-weight: 700;
  background: #08A85C;
  box-shadow: 0 8rpx 18rpx rgba(8, 168, 92, 0.18);
}

.filter-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.filter-pill {
  min-width: 150rpx;
  height: 50rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #404842;
  font-size: 23rpx;
  line-height: 50rpx;
  text-align: center;
  background: #fff;
  box-sizing: border-box;
}

.filter-pill.wide {
  min-width: 210rpx;
}

.chevron {
  color: #202722;
  font-size: 20rpx;
}

.search-bar {
  height: 58rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(18, 34, 27, 0.035);
}

.search-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  border: 3rpx solid #858d89;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -7rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #858d89;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  color: #333;
  font-size: 24rpx;
}

.order-list {
  padding-bottom: 18rpx;
}

.order-card {
  margin-bottom: 22rpx;
  padding: 18rpx 18rpx 14rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 6rpx 22rpx rgba(25, 38, 31, 0.055);
}

.order-main {
  display: flex;
}

.order-cover-wrap,
.order-cover {
  width: 214rpx;
  height: 184rpx;
  flex-shrink: 0;
  border-radius: 9rpx;
  overflow: hidden;
}

.order-cover.placeholder {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #24342c 0%, #101713 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-info {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
}

.order-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 7rpx;
}

.store-name {
  max-width: 320rpx;
  overflow: hidden;
  color: #111;
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.order-status {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
}

.status-pendingPay {
  color: #d78322;
}

.status-pendingUse,
.status-using,
.status-refunding,
.status-refunded {
  color: #08A85C;
}

.status-completed,
.status-cancelled {
  color: #8a8f8c;
}

.room-line {
  display: flex;
  align-items: center;
  color: #313a35;
  font-size: 23rpx;
  margin-bottom: 9rpx;
}

.room-name {
  max-width: 270rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.order-type {
  margin-left: 12rpx;
  padding: 2rpx 9rpx;
  border-radius: 5rpx;
  color: #08A85C;
  font-size: 18rpx;
  background: #edf8f2;
}

.detail-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  color: #6d746f;
  font-size: 22rpx;
}

.line-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  margin-right: 7rpx;
  flex-shrink: 0;
}

.line-icon.clock {
  border: 2rpx solid #8a928d;
  border-radius: 50%;
  box-sizing: border-box;
}

.line-icon.clock::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  width: 2rpx;
  height: 8rpx;
  background: #8a928d;
}

.line-icon.clock::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 13rpx;
  width: 7rpx;
  height: 2rpx;
  background: #8a928d;
  transform: rotate(28deg);
}

.line-icon.people::before,
.line-icon.people::after {
  content: '';
  position: absolute;
  border: 2rpx solid #8a928d;
  box-sizing: border-box;
}

.line-icon.people::before {
  left: 8rpx;
  top: 1rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.line-icon.people::after {
  left: 4rpx;
  bottom: 1rpx;
  width: 20rpx;
  height: 12rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  border-top: 2rpx solid #8a928d;
}

.duration {
  margin-left: auto;
  color: #505a54;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 13rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #e8ecea;
  color: #222;
  font-size: 23rpx;
}

.amount {
  color: #09a85c;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
}

.amount.paying {
  color: #e07821;
}

.currency {
  margin-right: 2rpx;
  font-size: 24rpx;
}

.order-tip {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f2f1;
  font-size: 21rpx;
}

.order-tip::before {
  content: 'ⓘ';
  margin-right: 7rpx;
}

.order-tip.warning {
  color: #d78322;
}

.order-tip.success {
  color: #08A85C;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 15rpx;
}

.action-btn {
  min-width: 132rpx;
  height: 50rpx;
  margin: 0;
  padding: 0 25rpx;
  border-radius: 8rpx;
  font-size: 23rpx;
  line-height: 50rpx;
}

.action-btn::after {
  border: none;
}

.action-btn.ghost {
  color: #08A85C;
  border: 1rpx solid #08A85C;
  background: #fff;
}

.action-btn.primary {
  color: #fff;
  background: #08A85C;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
}

.loading-text,
.empty-text {
  color: #8c9490;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 180rpx 0;
}

.list-bottom {
  padding: 12rpx 0 28rpx;
  color: #c0c4c2;
  font-size: 24rpx;
  text-align: center;
}

.cancel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.55);
}

.cancel-modal {
  position: fixed;
  left: 54rpx;
  right: 54rpx;
  top: 50%;
  z-index: 201;
  transform: translateY(-50%);
  padding: 42rpx 34rpx 34rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 28rpx 70rpx rgba(19, 43, 30, 0.18);
  box-sizing: border-box;
}

.cancel-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  color: #08A85C;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 76rpx;
  text-align: center;
  background: #eefaf4;
}

.cancel-title {
  display: block;
  color: #15221b;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.cancel-desc {
  display: block;
  margin: 16rpx auto 24rpx;
  max-width: 520rpx;
  color: #7a837e;
  font-size: 25rpx;
  line-height: 1.55;
  text-align: center;
}

.cancel-summary {
  overflow: hidden;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  border: 1rpx solid #edf1ef;
  background: #fbfcfb;
}

.cancel-row {
  min-height: 66rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf1ef;
  box-sizing: border-box;
}

.cancel-row:last-child {
  border-bottom: none;
}

.cancel-row text:first-child {
  flex-shrink: 0;
  color: #8a928d;
  font-size: 24rpx;
}

.cancel-row text:last-child {
  max-width: 380rpx;
  overflow: hidden;
  color: #243029;
  font-size: 25rpx;
  font-weight: 700;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cancel-row .cancel-amount {
  color: #e67c22;
  font-size: 30rpx;
  font-weight: 900;
}

.cancel-actions {
  display: flex;
  gap: 18rpx;
}

.cancel-action {
  flex: 1;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.cancel-action::after {
  border: none;
}

.cancel-action.secondary {
  color: #168856;
  border: 1rpx solid #20a767;
  background: #fff;
}

.cancel-action.primary {
  color: #fff;
  background: linear-gradient(135deg, #26bd72 0%, #08A85C 100%);
}
