.container {
  padding: 20rpx;
}

.room-header {
  display: flex;
  margin-bottom: 30rpx;
  background: white;
  border-radius: 10rpx;
  padding: 20rpx;
}

.room-image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.room-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.room-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.room-type {
  font-size: 28rpx;
  color: #666;
}

.room-price {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.room-details {
  background: white;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.detail-item {
  display: flex;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.label {
  width: 200rpx;
  color: #666;
  font-size: 28rpx;
}

.value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

.status-available {
  color: #52c41a;
}

.status-occupied {
  color: #ff4d4f;
}

.status-maintenance {
  color: #faad14;
}

.booking-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: white;
  border-top: 1rpx solid #f0f0f0;
}

.booking-btn {
  width: 100%;
  height: 88rpx;
  background: #1890ff;
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.booking-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}