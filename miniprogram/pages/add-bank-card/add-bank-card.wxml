<view class="container">
  <view class="header">
    <text class="title">添加银行卡</text>
    <text class="subtitle">请填写银行卡信息</text>
  </view>

  <view class="form-container">
    <view class="form-item">
      <text class="label">持卡人姓名</text>
      <input class="input" placeholder="请输入持卡人姓名" value="{{holderName}}" bindinput="onHolderNameInput" />
    </view>

    <view class="form-item">
      <text class="label">银行卡号</text>
      <input class="input" type="number" placeholder="请输入银行卡号" value="{{cardNo}}" bindinput="onCardNoInput" maxlength="19" />
      <text class="bank-name" wx:if="{{bankName}}">{{bankName}}</text>
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="请输入预留手机号" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>

    <view class="form-item">
      <text class="label">验证码</text>
      <view class="code-input-group">
        <input class="input code-input" type="number" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" maxlength="6" />
        <button class="code-btn" bindtap="sendCode" disabled="{{codeSending || countdown > 0}}">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </view>

    <view class="checkbox-item">
      <checkbox checked="{{isDefault}}" bindtap="toggleDefault" />
      <text class="checkbox-label">设为默认银行卡</text>
    </view>
  </view>

  <view class="button-container">
    <button class="submit-btn" bindtap="submitCard" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '确认添加'}}
    </button>
  </view>

  <view class="tips-section">
    <view class="tips-title">
      <image class="tips-icon" src="/images/info-icon.png"></image>
      <text>安全提示</text>
    </view>
    <view class="tips-content">
      <text class="tip-item">• 请确保银行卡为本人实名认证</text>
      <text class="tip-item">• 手机号需与银行预留号码一致</text>
      <text class="tip-item">• 银行卡信息将加密存储</text>
      <text class="tip-item">• 如有疑问请联系客服</text>
    </view>
  </view>
</view>
