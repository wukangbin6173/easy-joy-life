page {
  background: #f6f8f7;
}

.customer-page {
  min-height: 100vh;
  padding: 76rpx 22rpx 170rpx;
  box-sizing: border-box;
  background: #f6f8f7;
}

.nav {
  position: relative;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.back {
  position: absolute;
  left: 0;
  top: 0;
  width: 56rpx;
  height: 62rpx;
  color: #111;
  font-size: 58rpx;
  font-weight: 300;
  line-height: 56rpx;
}

.title {
  color: #111;
  font-size: 32rpx;
  font-weight: 800;
}

.hero {
  position: relative;
  min-height: 214rpx;
  padding: 32rpx 190rpx 32rpx 30rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: linear-gradient(118deg, #0aa65a 0%, #20c078 58%, #ddf7e9 100%);
  box-shadow: 0 14rpx 32rpx rgba(8, 168, 92, 0.18);
  box-sizing: border-box;
}

.hero-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.hero-eyebrow {
  align-self: flex-start;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #0c8f50;
  font-size: 20rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.84);
}

.hero-title {
  margin-top: 18rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.18;
}

.hero-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  line-height: 1.45;
}

.hero-image {
  position: absolute;
  right: 28rpx;
  bottom: 18rpx;
  width: 160rpx;
  height: 160rpx;
  opacity: 0.96;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 20rpx;
}

.quick-action {
  height: 86rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e3ebe7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #17211c;
  font-size: 27rpx;
  font-weight: 800;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(20, 43, 31, 0.05);
}

.quick-action.primary {
  color: #fff;
  border-color: #08a85c;
  background: #08a85c;
}

.quick-action image {
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
}

.quick-action.primary image {
  filter: brightness(0) invert(1);
}

.info-card {
  margin-top: 22rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(22, 48, 34, 0.06);
}

.info-row {
  min-height: 112rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #edf0ee;
  box-sizing: border-box;
}

.info-row:last-child {
  border-bottom: none;
}

.info-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #edf8f2;
}

.info-icon image {
  width: 36rpx;
  height: 36rpx;
}

.info-copy {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.info-label {
  color: #17211c;
  font-size: 28rpx;
  font-weight: 800;
}

.info-value {
  margin-top: 8rpx;
  color: #7a837e;
  font-size: 23rpx;
  line-height: 1.35;
}

.info-action {
  margin-left: 16rpx;
  color: #08a85c;
  font-size: 25rpx;
  font-weight: 700;
}

.notice-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  background: #eaf8f1;
}

.notice-card image {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.notice-card view {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.notice-title {
  color: #17211c;
  font-size: 26rpx;
  font-weight: 800;
}

.notice-text {
  margin-top: 8rpx;
  color: #68766e;
  font-size: 22rpx;
  line-height: 1.45;
}

.bottom-action {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 22rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(20, 43, 31, 0.08);
  box-sizing: border-box;
}

.bottom-action button {
  width: 100%;
  height: 86rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 86rpx;
  background: linear-gradient(135deg, #12b96d 0%, #07984d 100%);
  box-shadow: 0 10rpx 22rpx rgba(8, 168, 92, 0.22);
}

.bottom-action button::after {
  border: none;
}
