<view class="container">
  <view class="user-header" bindtap="onAvatarTap">
    <view class="avatar-section">
      <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="user-info">
        <text class="nickname">{{userInfo.nickname || '微信用户'}}</text>
        <text class="phone">{{userInfo.phone || '点击完善信息'}}</text>
      </view>
    </view>
    <view class="vip-section" wx:if="{{userInfo.isVip}}">
      <text class="vip-badge">VIP</text>
    </view>
    <view class="login-tip" wx:if="{{!userInfo.isLogin}}">
      <text class="login-text">完善信息</text>
    </view>
  </view>

  <view class="stats-section" wx:if="{{userInfo.isLogin}}">
    <view class="stat-item" bindtap="goToOrders">
      <text class="stat-number">{{stats.totalOrders}}</text>
      <text class="stat-label">总订单</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{stats.totalHours}}</text>
      <text class="stat-label">使用时长(h)</text>
    </view>
    <view class="stat-item">
      <text class="stat-number">{{stats.totalAmount}}</text>
      <text class="stat-label">消费金额</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="goToOrders">
        <view class="menu-icon">
          <image src="/images/order-active.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">我的订单</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToFavorites">
        <view class="menu-icon">
          <image src="/images/store-active.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">收藏门店</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToCoupons">
        <view class="menu-icon">
          <image src="/images/gift-icon.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">优惠券</text>
        <text class="menu-badge" wx:if="{{coupons.available > 0}}">{{coupons.available}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goToWallet">
        <view class="menu-icon">
          <image src="/images/wallet-icon.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">我的钱包</text>
        <text class="menu-desc" wx:if="{{userInfo.isLogin}}">余额: ¥{{wallet.balance}}</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToAddress">
        <view class="menu-icon">
          <image src="/images/location.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">收货地址</text>
        <text class="menu-arrow">></text>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-icon">
          <image src="/images/password-icon.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">设置</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-icon">
          <image src="/images/icon-service.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">帮助与反馈</text>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bindtap="contactService">
        <view class="menu-icon">
          <image src="/images/qr-icon.png" mode="aspectFit"></image>
        </view>
        <text class="menu-title">联系客服</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="logout-section" wx:if="{{userInfo.isLogin}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>