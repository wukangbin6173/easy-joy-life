.qx-dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9000;
  background: rgba(0, 0, 0, 0.56);
}

.qx-dialog-card {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  z-index: 9001;
  transform: translateY(-50%);
  padding: 38rpx 40rpx 34rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 30rpx 72rpx rgba(17, 43, 29, 0.2);
  box-sizing: border-box;
}

.qx-dialog-card.service-card {
  padding: 38rpx 34rpx 32rpx;
  border-radius: 26rpx;
}

.qx-service-head {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.qx-service-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf8f1;
  box-shadow: 0 8rpx 20rpx rgba(8, 168, 92, 0.12);
}

.qx-service-icon image {
  width: 50rpx;
  height: 50rpx;
}

.qx-service-title {
  margin-top: 20rpx;
  color: #15221b;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.qx-service-desc {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: #77847d;
  font-size: 24rpx;
  line-height: 1.45;
}

.qx-service-info {
  margin: 28rpx 0 30rpx;
  padding: 8rpx 22rpx;
  border-radius: 18rpx;
  background: #f7faf8;
}

.qx-service-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #e8efeb;
}

.qx-service-row:last-child {
  border-bottom: none;
}

.qx-service-row image {
  width: 42rpx;
  height: 42rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.qx-service-row view {
  min-width: 0;
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.qx-service-label {
  color: #6f7c75;
  font-size: 24rpx;
}

.qx-service-value {
  color: #17211c;
  font-size: 27rpx;
  font-weight: 800;
}

.qx-dialog-icon {
  width: 62rpx;
  height: 62rpx;
  margin: 0 auto 18rpx;
  border-radius: 50%;
  color: #08A85C;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 62rpx;
  text-align: center;
  background: #eefaf4;
}

.qx-dialog-icon.warn,
.qx-dialog-icon.confirm {
  color: #e68a22;
  background: #fff5e8;
}

.qx-dialog-title {
  display: block;
  color: #15221b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.qx-dialog-content {
  display: block;
  width: 100%;
  margin: 18rpx 0 32rpx;
  color: #74807a;
  font-size: 26rpx;
  line-height: 1.68;
  text-align: left;
  white-space: pre-line;
  box-sizing: border-box;
}

.qx-dialog-input {
  width: 100%;
  min-height: 150rpx;
  margin: 8rpx 0 30rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  color: #1f2b25;
  font-size: 26rpx;
  line-height: 1.45;
  background: #f7faf8;
  border: 1rpx solid #e8efeb;
  box-sizing: border-box;
}

.qx-dialog-actions {
  display: flex;
  gap: 18rpx;
  align-items: center;
  width: 100%;
}

.qx-dialog-actions.single {
  justify-content: center;
}

.qx-dialog-btn {
  width: 0;
  flex: 1 1 0;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
  box-sizing: border-box;
}

.qx-dialog-actions.single .qx-dialog-btn {
  width: 360rpx;
  flex: none;
}

.qx-dialog-btn::after {
  border: none;
}

.qx-dialog-btn.secondary {
  color: #168856;
  border: 1rpx solid #20a767;
  background: #fff;
}

.qx-dialog-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #26bd72 0%, #08A85C 100%);
}
