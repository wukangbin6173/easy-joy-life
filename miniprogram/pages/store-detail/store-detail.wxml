<!--门店详情页-->
<view class="container">
  <!-- 门店图片轮播 -->
  <swiper class="store-banner" indicator-dots autoplay circular>
    <swiper-item wx:for="{{store.images || ['/images/default-store.jpg']}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" class="banner-img"></image>
    </swiper-item>
  </swiper>

  <!-- 门店信息 -->
  <view class="store-info-card">
    <view class="store-name-row">
      <text class="store-name">{{store.name || '加载中...'}}</text>
      <view class="wifi-tag" wx:if="{{store.hasWifi}}">
        <text>WiFi</text>
      </view>
    </view>

    <!-- 余额 + 积分 -->
    <view class="balance-row">
      <view class="balance-item" bindtap="goToRecharge">
        <text class="balance-emoji">💰</text>
        <text class="balance-value">{{walletBalance || 0}}</text>
        <text class="balance-label">充值余额</text>
      </view>
      <view class="balance-divider"></view>
      <view class="balance-item">
        <text class="balance-emoji">🎁</text>
        <text class="balance-value">{{userPoints || 0}}</text>
        <text class="balance-label">消费金额的{{pointsRate || 2}}%返积分</text>
      </view>
    </view>

    <!-- 联系电话 + 地址 -->
    <view class="store-contact" wx:if="{{store.phone}}" bindtap="callStore">
      <text class="contact-icon">📞</text>
      <text class="contact-text">联系电话：{{store.phone}}</text>
    </view>
    <view class="store-address-row" wx:if="{{store.address}}" bindtap="openMap">
      <text class="contact-icon">📍</text>
      <text class="contact-text">{{store.address}}</text>
    </view>
  </view>

  <!-- 房间列表 -->
  <view class="room-section">
    <view class="room-card" wx:for="{{rooms}}" wx:key="id">
      <view class="room-top" bindtap="onRoomTap" data-room="{{item}}">
        <view class="room-left">
          <text class="room-name">{{item.name}}</text>
          <image wx:if="{{item.brandLogo}}" src="{{item.brandLogo}}" class="brand-logo" mode="aspectFit"></image>
        </view>
        <view class="room-center">
          <text class="room-price">{{item.pricePerHour || 15}}</text>
          <text class="room-price-unit">元/小时</text>
        </view>
        <view class="room-right">
          <button class="book-btn" catchtap="onRoomTap" data-room="{{item}}">预订</button>
        </view>
      </view>
      <!-- 时间轴可视化 -->
      <view class="timeline-row">
        <view class="timeline-hours">
          <text class="tl-hour" wx:for="{{timelineHours}}" wx:for-item="h" wx:key="*this">{{h}}</text>
        </view>
        <view class="timeline-bar">
          <view class="tl-segment {{seg.status}}" wx:for="{{item.timeline || defaultTimeline}}" wx:for-item="seg" wx:key="hour"
                style="width: {{seg.width}}%;"></view>
        </view>
        <view class="timeline-legend">
          <view class="legend-item"><view class="legend-dot booked"></view><text>已预约</text></view>
          <view class="legend-item"><view class="legend-dot available"></view><text>可预约</text></view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 预订弹窗遮罩 -->
<view class="booking-mask" wx:if="{{showBooking}}" bindtap="closeBooking"></view>
<!-- 预订弹窗 -->
<view class="booking-popup {{showBooking ? 'show' : ''}}" catchtap="">
  <!-- 弹窗头部 -->
  <view class="popup-header">
    <text class="popup-room-name">{{selectedRoom.name}}</text>
    <text class="popup-close" bindtap="closeBooking">✕</text>
  </view>

  <!-- 模式切换 -->
  <view class="mode-tabs">
    <view class="mode-tab {{bookingMode === 'time' ? 'active' : ''}}" bindtap="switchMode" data-mode="time">预约模式</view>
    <view class="mode-tab {{bookingMode === 'package' ? 'active' : ''}}" bindtap="switchMode" data-mode="package">套餐模式</view>
  </view>

  <!-- 房间数量 -->
  <view class="room-count-row">
    <view class="count-btn" bindtap="changeCount" data-delta="-1">-</view>
    <text class="count-value">{{roomCount}}</text>
    <view class="count-btn" bindtap="changeCount" data-delta="1">+</view>
  </view>

  <!-- 日期选择 -->
  <view class="date-tabs">
    <view class="date-tab {{selectedDate === dates[0] ? 'active' : ''}}"
          bindtap="selectDate" data-date="{{dates[0]}}">{{dates[0]}}</view>
    <view class="date-tab {{selectedDate === dates[1] ? 'active' : ''}}"
          bindtap="selectDate" data-date="{{dates[1]}}">{{dates[1]}}</view>
  </view>

  <!-- 预约模式 -->
  <view wx:if="{{bookingMode === 'time'}}">
    <!-- 时长快捷筛选 Tab -->
    <view class="duration-tabs">
      <view class="dur-tab {{selectedDuration === 4 ? 'active' : ''}}" bindtap="selectDuration" data-dur="4">4小时</view>
      <view class="dur-tab {{selectedDuration === 5 ? 'active' : ''}}" bindtap="selectDuration" data-dur="5">5小时</view>
      <view class="dur-tab {{selectedDuration === 6 ? 'active' : ''}}" bindtap="selectDuration" data-dur="6">6小时</view>
      <view class="dur-tab {{selectedDuration === 8 ? 'active' : ''}}" bindtap="selectDuration" data-dur="8">8小时</view>
      <view class="dur-tab {{selectedDuration === 0 ? 'active' : ''}}" bindtap="selectDuration" data-dur="0">其他</view>
    </view>

    <!-- 套餐快捷选择 -->
    <view class="package-select-row">
      <text class="package-label">预定套餐</text>
      <picker bindchange="onPackageSelect" value="{{selectedPackageIdx + 1}}" range="{{packageNames}}">
        <view class="package-picker">{{selectedPackageIdx >= 0 ? packageNames[selectedPackageIdx + 1] : '请选择套餐'}}</view>
      </picker>
    </view>

    <!-- 时间格子 -->
    <scroll-view scroll-y class="time-grid-scroll">
      <view class="time-grid">
        <view class="time-slot {{item.selected ? 'selected' : ''}} {{item.status === 'booked' ? 'booked' : ''}}"
              wx:for="{{timeSlots}}" wx:key="hour"
              bindtap="toggleSlot" data-index="{{index}}">
          <text class="slot-status">{{item.status === 'booked' ? '已占' : '空闲'}}</text>
          <text class="slot-time">{{item.timeRange}}</text>
          <text class="slot-price" wx:if="{{item.status !== 'booked'}}">¥ {{item.price}}/h</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 套餐模式 -->
  <view wx:if="{{bookingMode === 'package'}}">
    <view class="package-select-row">
      <text class="package-label">预定套餐</text>
      <picker bindchange="onPackageSelect" value="{{selectedPackageIdx + 1}}" range="{{packageNames}}">
        <view class="package-picker">{{selectedPackageIdx >= 0 ? packageNames[selectedPackageIdx + 1] : '请选择套餐'}}</view>
      </picker>
    </view>
    <view class="package-list">
      <view class="package-item {{selectedPackageIdx === index ? 'selected' : ''}}"
            wx:for="{{packages}}" wx:key="id"
            bindtap="selectPackage" data-index="{{index}}">
        <text class="package-name">{{item.name}}</text>
        <text class="package-price">{{item.price}}元</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="popup-footer">
    <view class="footer-summary">
      <text class="summary-text">已选：<text class="highlight">{{selectedHours}}小时</text></text>
      <text class="summary-price">共: <text class="highlight">¥{{totalPrice}}</text></text>
    </view>
    <view class="footer-actions">
      <view class="action-btn recharge-btn" bindtap="goToRecharge">
        <text>余额充值</text>
        <text>(享优惠)</text>
      </view>
      <view class="action-btn confirm-btn" bindtap="confirmBooking">确认预订</view>
    </view>
  </view>
</view>
