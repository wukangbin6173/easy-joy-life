/* 门店详情页 */
page {
  background: #f8faf9;
}

.detail-page {
  min-height: 100vh;
  padding: 74rpx 20rpx 196rpx;
  box-sizing: border-box;
  background: #f8faf9;
}

.custom-nav {
  position: relative;
  height: 60rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  position: absolute;
  left: 0;
  top: 0;
  width: 54rpx;
  height: 60rpx;
  color: #111;
  font-size: 54rpx;
  line-height: 54rpx;
  font-weight: 300;
}

.nav-title {
  color: #151515;
  font-size: 31rpx;
  font-weight: 700;
}

.hero-card {
  position: relative;
  overflow: hidden;
  height: 220rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #eaf8f1;
}

.store-swiper,
.store-cover {
  width: 100%;
  height: 100%;
}

.image-count {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  background: rgba(0, 0, 0, 0.55);
}

.store-card,
.panel {
  border-radius: 0 0 18rpx 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(22, 48, 34, 0.06);
}

.store-card {
  padding: 18rpx 22rpx 20rpx;
  margin-bottom: 16rpx;
}

.store-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.store-title-block {
  display: flex;
  align-items: center;
  min-width: 0;
}

.store-name {
  max-width: 440rpx;
  overflow: hidden;
  color: #151515;
  font-size: 31rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.type-tag {
  margin-left: 12rpx;
  padding: 3rpx 9rpx;
  border-radius: 5rpx;
  color: #08A85C;
  font-size: 19rpx;
  background: #edf8f2;
}

.distance-block {
  display: flex;
  align-items: center;
  color: #7a8580;
  font-size: 22rpx;
}

.distance-block image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.address-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  color: #57615b;
  font-size: 23rpx;
}

.address-row image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.store-tags {
  display: flex;
  gap: 14rpx;
  margin: 16rpx 0;
}

.store-tags text,
.intro-tags text {
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  color: #08A85C;
  font-size: 20rpx;
  background: #edf8f2;
}

.action-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  height: 54rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 24rpx;
  border: 1rpx solid #edf0ee;
}

.favorite-action.active {
  color: #08A85C;
  border-color: #b9e8d2;
  background: #eef9f3;
}

.action-btn image {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
}

.asset-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-radius: 12rpx;
  border: 1rpx solid #edf0ee;
}

.asset-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.asset-item image {
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
}

.asset-label,
.asset-value {
  display: block;
  color: #25302a;
  font-size: 24rpx;
}

.asset-value {
  margin-top: 4rpx;
  font-size: 26rpx;
}

.asset-divider {
  width: 1rpx;
  height: 58rpx;
  background: #edf0ee;
}

.panel {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
}

.panel-title {
  color: #1c241f;
  font-size: 27rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.panel-title.small {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
  font-size: 25rpx;
}

.room-panel {
  padding-bottom: 20rpx;
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.panel-heading-main {
  min-width: 0;
}

.room-panel-title {
  margin-bottom: 4rpx;
}

.selected-room-pill {
  max-width: 230rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #08A85C;
  font-size: 21rpx;
  background: #eef9f3;
  box-sizing: border-box;
}

.selected-room-name {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-scroll {
  white-space: nowrap;
}

.room-list {
  display: inline-flex;
  gap: 18rpx;
  padding-bottom: 4rpx;
}

.room-empty {
  width: 650rpx;
  padding: 36rpx 0;
  text-align: center;
  color: #8a9190;
  font-size: 26rpx;
}

.room-card {
  position: relative;
  width: 278rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid #edf0ee;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 6rpx 18rpx rgba(20, 43, 31, 0.04);
}

.room-card.active {
  border-color: #08A85C;
  background: linear-gradient(180deg, #f7fffb 0%, #fff 62%);
  box-shadow: 0 10rpx 24rpx rgba(8, 168, 92, 0.14);
}

.room-card.disabled {
  background: #fafafa;
}

.room-cover-wrap {
  position: relative;
  width: 100%;
  height: 138rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #eef5f1;
}

.room-img {
  width: 100%;
  height: 100%;
}

.room-status-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  z-index: 2;
  max-width: 112rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #08A85C;
  font-size: 19rpx;
  line-height: 34rpx;
  background: rgba(238, 249, 243, 0.96);
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-status-badge.booked {
  color: #ef4d64;
  background: rgba(255, 239, 242, 0.96);
}

.room-status-badge.cleaning {
  color: #c97812;
  background: rgba(255, 247, 231, 0.96);
}

.room-status-badge.disabled {
  color: #7f8984;
  background: rgba(241, 243, 242, 0.96);
}

.room-selected-mark {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
  background: #08A85C;
  box-shadow: 0 4rpx 12rpx rgba(8, 168, 92, 0.28);
}

.room-info {
  min-height: 84rpx;
  padding-top: 12rpx;
}

.room-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.room-name {
  max-width: 170rpx;
  overflow: hidden;
  color: #1e2621;
  font-size: 25rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-detail-entry {
  flex-shrink: 0;
  color: #08A85C;
  font-size: 20rpx;
}

.room-meta-line {
  display: flex;
  gap: 10rpx;
  min-height: 32rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.room-meta-line text {
  max-width: 116rpx;
  overflow: hidden;
  color: #7a837e;
  font-size: 20rpx;
  line-height: 32rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
}

.room-price-wrap {
  min-width: 0;
  display: flex;
  align-items: baseline;
}

.room-price {
  color: #e67c22;
  font-size: 30rpx;
  font-weight: 900;
}

.room-unit {
  max-width: 76rpx;
  overflow: hidden;
  color: #e67c22;
  font-size: 18rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-select-btn {
  flex-shrink: 0;
  width: 82rpx;
  height: 42rpx;
  border-radius: 999rpx;
  color: #08A85C;
  font-size: 22rpx;
  line-height: 42rpx;
  text-align: center;
  border: 1rpx solid #08A85C;
  background: #fff;
  box-sizing: border-box;
}

.room-select-btn.selected {
  color: #fff;
  border-color: #08A85C;
  background: #08A85C;
}

.room-select-btn.disabled {
  color: #9aa39e;
  border-color: #e3e7e5;
  background: #f4f5f4;
}

.more-room {
  width: 320rpx;
  height: 54rpx;
  margin: 18rpx auto 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #08A85C;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
  border: 1rpx solid #cfeedd;
  background: #f3fbf7;
  box-sizing: border-box;
}

.more-room-arrow {
  font-size: 30rpx;
  line-height: 1;
}

.method-grid,
.booking-date-tabs,
.time-grid,
.duration-grid {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.booking-date-tabs,
.time-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.duration-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.method-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.method-title {
  flex-shrink: 0;
  margin-bottom: 0;
}

.method-intro-scroll {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 32rpx;
  overflow: hidden;
  white-space: nowrap;
}

.method-intro-track {
  display: inline-block;
  padding-left: 100%;
  white-space: nowrap;
  animation: methodIntroMarquee 14s linear infinite;
}

.method-intro {
  display: inline;
  color: #6d7771;
  font-size: 21rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

@keyframes methodIntroMarquee {
  0% {
    transform: translateX(0);
  }

  100% {
    transform: translateX(-100%);
  }
}

.date-panel {
  padding-top: 14rpx;
  padding-bottom: 14rpx;
}

.date-header-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.date-title {
  flex-shrink: 0;
  margin-bottom: 0;
}

.date-tabs-inline {
  flex: none;
  display: flex;
  gap: 12rpx;
}

.date-tabs-inline .booking-date-tab {
  width: 158rpx;
  flex: none;
}

.booking-entry {
  margin: 0 20rpx 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dbeee5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #f7fffb;
  box-sizing: border-box;
}

.booking-entry-title {
  display: block;
  color: #202722;
  font-size: 26rpx;
  font-weight: 700;
}

.booking-entry-sub {
  display: block;
  margin-top: 6rpx;
  color: #738079;
  font-size: 22rpx;
  line-height: 1.35;
}

.booking-entry-action {
  flex-shrink: 0;
  min-width: 72rpx;
  height: 48rpx;
  border-radius: 24rpx;
  color: #fff;
  background: #08A85C;
  font-size: 22rpx;
  line-height: 48rpx;
  text-align: center;
}

.method-card {
  position: relative;
  flex: 1;
  min-width: 190rpx;
  height: 88rpx;
  padding: 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid #edf0ee;
  box-sizing: border-box;
}

.method-card.active {
  border-color: #08A85C;
  background: #f8fffb;
}

.method-card.disabled {
  color: #a5ada9;
  border-color: #edf0ee;
  background: #f6f7f6;
}

.method-card.disabled .method-name,
.method-card.disabled .method-price,
.method-card.disabled .method-desc {
  color: #a5ada9;
}

.method-check {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 18rpx;
  line-height: 24rpx;
  text-align: center;
  background: #08A85C;
}

.method-name {
  display: block;
  color: #202722;
  font-size: 24rpx;
  font-weight: 700;
}

.method-price {
  color: #e67c22;
  font-size: 22rpx;
}

.method-desc {
  color: #8b948f;
  font-size: 19rpx;
}

.booking-date-tab,
.time-chip,
.duration-chip {
  min-width: 0;
  width: 100%;
  min-height: 48rpx;
  padding: 6rpx 6rpx;
  border-radius: 8rpx;
  color: #333;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: center;
  border: 1rpx solid #e6ebe8;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.booking-date-tab.active,
.time-chip.active,
.duration-chip.active {
  color: #08A85C;
  border-color: #08A85C;
  background: #f3fbf7;
}

.time-chip.disabled {
  color: #b5bbb8;
  background: #f5f6f5;
  line-height: 1.15;
  padding-top: 7rpx;
}

.time-empty {
  padding: 28rpx 0;
  color: #8a938e;
  font-size: 24rpx;
  text-align: center;
}

.disabled-text {
  display: block;
  font-size: 16rpx;
  line-height: 1.1;
}

.expand-line {
  margin-top: 14rpx;
  height: 44rpx;
  color: #08A85C;
  font-size: 23rpx;
  line-height: 44rpx;
  text-align: center;
}

.duration-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.end-time {
  color: #08A85C;
  font-size: 22rpx;
  max-width: 270rpx;
  line-height: 1.25;
  text-align: right;
}

.package-duration-note {
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
  color: #53615a;
  font-size: 23rpx;
  line-height: 1.6;
  background: #f6faf8;
}

.package-duration-note text {
  display: block;
}

.intro-panel,
.notice-panel {
  color: #4f5b54;
  font-size: 23rpx;
  line-height: 1.65;
}

.intro-text {
  display: block;
}

.intro-tags {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.notice-panel text {
  display: block;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  min-height: 134rpx;
  padding: 28rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(20, 43, 31, 0.08);
  box-sizing: border-box;
}

.price-summary {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.price {
  color: #e67c22;
  font-size: 38rpx;
  font-weight: 800;
}

.summary-text {
  display: block;
  max-width: 250rpx;
  overflow: hidden;
  color: #7a837e;
  font-size: 20rpx;
  line-height: 1.35;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bottom-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 82rpx;
}

.recharge-btn,
.confirm-btn {
  height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}

.recharge-btn::after,
.confirm-btn::after {
  border: none;
}

.recharge-btn {
  width: 168rpx;
  color: #08A85C;
  border: none;
  background: #fff;
  box-shadow: inset 0 0 0 2rpx #08A85C;
}

.confirm-btn {
  width: 244rpx;
  color: #fff;
  background: #08A85C;
}

/* 下单支付确认弹窗 */
.confirm-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  background: rgba(0, 0, 0, 0.62);
}

.confirm-modal {
  position: fixed;
  left: 58rpx;
  right: 58rpx;
  top: 50%;
  z-index: 301;
  transform: translateY(-50%);
  padding: 42rpx 40rpx 38rpx;
  border-radius: 34rpx;
  background: #fff;
  box-sizing: border-box;
}

.confirm-close {
  position: absolute;
  top: 22rpx;
  right: 26rpx;
  width: 42rpx;
  height: 42rpx;
  color: #7f8783;
  font-size: 44rpx;
  line-height: 38rpx;
  text-align: center;
}

.confirm-head {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.confirm-icon {
  width: 84rpx;
  height: 84rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.confirm-title-wrap {
  display: flex;
  flex-direction: column;
}

.confirm-title {
  color: #161d19;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
}

.confirm-subtitle {
  margin-top: 14rpx;
  color: #828b86;
  font-size: 23rpx;
}

.confirm-table {
  overflow: hidden;
  border-radius: 14rpx;
  border: 1rpx solid #edf0ee;
  background: #fff;
}

.confirm-row {
  min-height: 66rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf0ee;
}

.confirm-row:last-child {
  border-bottom: none;
}

.confirm-label {
  color: #7b8580;
  font-size: 25rpx;
}

.confirm-value {
  max-width: 350rpx;
  overflow: hidden;
  color: #202923;
  font-size: 26rpx;
  text-align: right;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.amount-row-confirm {
  min-height: 86rpx;
  background: linear-gradient(90deg, #fff 0%, #fffaf3 100%);
}

.amount-label {
  color: #333d37;
  font-weight: 700;
}

.confirm-amount {
  color: #e87122;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.confirm-tip {
  margin: 22rpx 0 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  color: #168856;
  font-size: 22rpx;
  line-height: 1.45;
  display: flex;
  align-items: flex-start;
  background: #effaf4;
}

.confirm-tip image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.confirm-actions {
  display: flex;
  gap: 22rpx;
  align-items: center;
}

.confirm-cancel-btn,
.confirm-pay-btn {
  width: 0;
  flex: 1 1 0;
  height: 86rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 86rpx;
  text-align: center;
}

.confirm-cancel-btn::after,
.confirm-pay-btn::after {
  border: none;
}

.confirm-cancel-btn {
  color: #168856;
  border: 1rpx solid #168856;
  background: #fff;
  overflow: visible;
}

.confirm-pay-btn {
  color: #fff;
  background: linear-gradient(135deg, #28bd71 0%, #08A85C 100%);
}

/* ===== 下单弹窗（全屏，完全仿截图） ===== */
.booking-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.booking-popup {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: #f5f5f5; z-index: 101;
  transform: translateY(100%); transition: transform 0.3s ease;
  display: flex; flex-direction: column;
}
.booking-popup.show { transform: translateY(0); }

/* 顶部黄色导航栏 */
.popup-top { background: #F5A623; padding: 0 24rpx 20rpx; padding-top: calc(env(safe-area-inset-top) + 80rpx); }
.popup-header { display: flex; align-items: center; height: 80rpx; position: relative; justify-content: center; }
.popup-title { font-size: 36rpx; font-weight: bold; color: #fff; }
.popup-close { position: absolute; left: 0; font-size: 48rpx; color: #fff; padding: 0 20rpx; line-height: 80rpx; }

/* 信息卡片 */
.booking-info { background: #fff; border: 3rpx solid #F5A623; border-radius: 16rpx; padding: 28rpx; margin-top: 16rpx; }
.info-line { display: block; font-size: 30rpx; color: #333; font-weight: bold; line-height: 2; }
.info-status-row { display: flex; align-items: center; }
.info-label { font-size: 30rpx; color: #333; font-weight: bold; }
.status-tag-green { background: #f6ffed; color: #52c41a; font-size: 24rpx; padding: 6rpx 24rpx; border-radius: 24rpx; border: 2rpx solid #b7eb8f; margin-left: 12rpx; }

/* 滚动内容区 */
.popup-scroll { flex: 1; overflow-y: auto; }

/* 日期选择 */
.date-section { padding: 24rpx 24rpx 12rpx; }
.date-scroll { white-space: nowrap; }
.date-tabs { display: inline-flex; gap: 16rpx; }
.date-tab { display: inline-flex; flex-direction: column; align-items: center; padding: 16rpx 24rpx; border-radius: 12rpx; border: 2rpx solid #e0e0e0; background: #fff; min-width: 110rpx; }
.date-tab.active { border-color: #F5A623; }
.date-day { font-size: 28rpx; font-weight: bold; color: #333; }
.date-tab.active .date-day { color: #F5A623; }
.date-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.date-tab.active .date-label { color: #F5A623; }

/* 套餐选择 */
.package-section { padding: 20rpx 24rpx 12rpx; }
.section-label { font-size: 32rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.package-scroll { white-space: nowrap; }
.package-tabs { display: inline-flex; gap: 20rpx; }
.pkg-tab { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; padding: 24rpx 32rpx; border-radius: 12rpx; border: 2rpx solid #e0e0e0; background: #fff; min-width: 180rpx; }
.pkg-tab.active { border-color: #F5A623; background: #fff8e6; }
.pkg-name { font-size: 28rpx; color: #333; margin-bottom: 10rpx; }
.pkg-tab.active .pkg-name { color: #F5A623; font-weight: bold; }
.pkg-price { font-size: 36rpx; font-weight: bold; color: #ff4d4f; }

/* 时间选择 */
.time-section { padding: 20rpx 24rpx 12rpx; }
.time-picker-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.time-picker-box { flex: 1; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 12rpx; padding: 28rpx 16rpx; gap: 10rpx; border: 2rpx solid #e0e0e0; }
.time-picker-box.fixed { background: #fff8e6; border-color: #F5A623; }
.time-picker-value { font-size: 36rpx; font-weight: bold; color: #333; }
.time-picker-icon { font-size: 32rpx; }
.time-picker-sep { font-size: 32rpx; color: #666; font-weight: bold; }

/* 订单总价 */
.order-summary { background: #fff; border-radius: 16rpx; padding: 28rpx; margin: 20rpx 24rpx; border: 2rpx solid #f0f0f0; }
.summary-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #f0f0f0; }
.summary-label { font-size: 34rpx; font-weight: bold; color: #333; }
.summary-amount { font-size: 44rpx; font-weight: bold; color: #ff4d4f; }
.summary-detail { display: flex; justify-content: space-between; font-size: 28rpx; color: #999; margin-bottom: 12rpx; }

/* 底部固定栏 */
.popup-footer { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 2rpx solid #f0f0f0; }
.footer-left { flex: 1; }
.footer-pay-label { font-size: 28rpx; color: #333; }
.footer-pay-amount { font-size: 44rpx; font-weight: bold; color: #ff4d4f; }
.footer-pay-desc { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
.footer-confirm-btn { background: #F5A623; color: #fff; font-size: 34rpx; font-weight: bold; padding: 28rpx 64rpx; border-radius: 48rpx; white-space: nowrap; }

/* 手机验证弹窗 */
.phone-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 200; }
.phone-modal { position: fixed; left: 40rpx; right: 40rpx; top: 50%; transform: translateY(-50%); background: #fff; border-radius: 20rpx; padding: 40rpx; z-index: 201; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40rpx; }
.modal-title { font-size: 34rpx; font-weight: bold; color: #333; }
.modal-close { font-size: 36rpx; color: #999; padding: 10rpx; }
.modal-body { margin-bottom: 30rpx; }
.modal-input-row { margin-bottom: 24rpx; }
.modal-input { width: 100%; height: 80rpx; background: #f5f5f5; border-radius: 10rpx; padding: 0 20rpx; font-size: 30rpx; color: #333; box-sizing: border-box; }
.code-row { display: flex; gap: 16rpx; }
.code-input { flex: 1; width: auto; }
.send-code-btn { width: 200rpx; height: 80rpx; line-height: 80rpx; font-size: 26rpx; background: #F5A623; color: #fff; border-radius: 10rpx; padding: 0; flex-shrink: 0; }
.send-code-btn.disabled { background: #ccc; }
.send-code-btn::after { border: none; }
.modal-confirm-btn { width: 100%; height: 88rpx; background: #F5A623; color: #fff; border-radius: 44rpx; font-size: 32rpx; }
.modal-confirm-btn::after { border: none; }

/* 预约关闭提示条 */
.booking-notice-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 16rpx 22rpx;
  border-radius: 10rpx;
  color: #8a6d3b;
  font-size: 24rpx;
  background: #fdf8ed;
  border: 1rpx solid #f5e6c8;
}

.booking-notice-icon {
  flex-shrink: 0;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #d4a94b;
}

.booking-notice-text {
  line-height: 1.4;
}

/* 页面加载骨架屏 */
.page-loading {
  padding: 0 20rpx;
}

.skeleton-hero {
  height: 220rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #eef5f1 25%, #f5faf7 50%, #eef5f1 75%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-card {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #eef5f1 25%, #f5faf7 50%, #eef5f1 75%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.5s infinite;
  margin-bottom: 18rpx;
}

.skeleton-line.long { width: 80%; }
.skeleton-line.medium { width: 55%; }
.skeleton-line.short { width: 35%; }
.skeleton-line:last-child { margin-bottom: 0; }

@keyframes skeletonShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 所有资源不可用引导面板 */
.all-unavailable-panel {
  text-align: center;
  padding: 40rpx 20rpx;
}

.all-unavailable-text {
  display: block;
  color: #5a6560;
  font-size: 26rpx;
  font-weight: 600;
}

.all-unavailable-hint {
  display: block;
  margin-top: 12rpx;
  color: #8a938e;
  font-size: 23rpx;
}

.all-unavailable-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  color: #08A85C;
  font-size: 24rpx;
  border: 1rpx solid #08A85C;
}

/* 时间为空时的引导提示 */
.time-empty-hint {
  display: block;
  margin-top: 8rpx;
  color: #08A85C;
  font-size: 22rpx;
}
