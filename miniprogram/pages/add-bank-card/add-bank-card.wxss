.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 头部 */
.header {
  padding: 40rpx 20rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 表单 */
.form-container {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
}

.form-item {
  margin-bottom: 40rpx;
  position: relative;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: #F5A623;
}

.bank-name {
  position: absolute;
  right: 20rpx;
  top: 70rpx;
  font-size: 24rpx;
  color: #F5A623;
}

.code-input-group {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 200rpx;
  height: 80rpx;
  background: #F5A623;
  color: white;
  border-radius: 10rpx;
  font-size: 26rpx;
  border: none;
  padding: 0;
  line-height: 80rpx;
}

.code-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}

.checkbox-item {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.checkbox-label {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 按钮 */
.button-container {
  padding: 30rpx 20rpx;
}

.submit-btn {
  width: 100%;
  background: #F5A623;
  color: white;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 32rpx;
  border: none;
}

.submit-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}

/* 温馨提示 */
.tips-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
}

.tips-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.tips-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
}

.tip-item {
  font-size: 26rpx;
  color: #666;
  line-height: 40rpx;
  margin-bottom: 10rpx;
}
