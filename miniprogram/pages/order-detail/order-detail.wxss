.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.order-status {
  background: white;
  text-align: center;
  padding: 60rpx 30rpx;
  margin-bottom: 20rpx;
}

.status-icon image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
}

.status-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 28rpx;
  color: #666;
}

.order-info {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  width: 200rpx;
  color: #666;
  font-size: 28rpx;
}

.info-item .value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

.price-detail {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.detail-item .label {
  color: #666;
  font-size: 28rpx;
}

.detail-item .value {
  color: #333;
  font-size: 28rpx;
}

.detail-item .discount {
  color: #52c41a;
}

.detail-item.total {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 15rpx;
  padding-top: 20rpx;
}

.detail-item.total .label {
  color: #333;
  font-weight: bold;
}

.detail-item.total .value {
  color: #ff4d4f;
  font-size: 36rpx;
  font-weight: bold;
}

.unlock-info {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.unlock-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.unlock-code {
  font-size: 72rpx;
  font-weight: bold;
  color: #1890ff;
  letter-spacing: 10rpx;
  margin-bottom: 20rpx;
}

.unlock-tip {
  font-size: 24rpx;
  color: #999;
}

.order-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: white;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: 1rpx solid #d9d9d9;
  background: white;
  color: #666;
}

.action-btn.primary {
  background: #1890ff;
  color: white;
  border-color: #1890ff;
}