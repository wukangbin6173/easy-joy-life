.payment-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.payment-header {
  background: #1890ff;
  color: white;
  padding: 20rpx;
  text-align: center;
}

.payment-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.payment-tip {
  font-size: 28rpx;
  opacity: 0.9;
}

web-view {
  flex: 1;
}

.payment-footer {
  background: white;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}

.cancel-btn, .check-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

.check-btn {
  background: #1890ff;
  color: white;
}