page { background: #f8faf9; }
.page { min-height: 100vh; padding: 76rpx 22rpx 40rpx; box-sizing: border-box; }
.nav { position: relative; height: 60rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.back { position: absolute; left: 0; top: 0; width: 54rpx; height: 60rpx; font-size: 54rpx; line-height: 54rpx; color: #111; }
.title { font-size: 32rpx; font-weight: 800; color: #111; }
.brand-card { padding: 46rpx 30rpx; border-radius: 24rpx; background: linear-gradient(120deg,#effaf4,#dff6ea); display: flex; flex-direction: column; align-items: center; }
.logo { width: 92rpx; height: 92rpx; border: 3rpx solid #0a8a4d; border-radius: 50%; color: #0a8a4d; font-size: 56rpx; font-weight: 900; line-height: 92rpx; text-align: center; }
.name { margin-top: 18rpx; color: #0a8a4d; font-size: 38rpx; font-weight: 900; }
.slogan { margin-top: 12rpx; color: #178a56; font-size: 24rpx; }
.info-card, .list { margin-top: 22rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(22,48,34,.06); }
.info-card text { display: block; color: #4f5b54; font-size: 27rpx; line-height: 1.7; margin-bottom: 16rpx; }
.list view { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #edf0ee; color: #26302a; font-size: 27rpx; }
.list view:last-child { border-bottom: none; }
.list view text:last-child { color: #7a837e; }
