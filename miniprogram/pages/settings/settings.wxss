.container { background: #f5f5f5; min-height: 100vh; }
.version-card {
  display: flex; flex-direction: column; align-items: center;
  background: #fff; padding: 60rpx 0; margin-bottom: 20rpx;
}
.app-logo { width: 120rpx; height: 120rpx; margin-bottom: 20rpx; }
.app-name { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; }
.version { font-size: 26rpx; color: #999; }
