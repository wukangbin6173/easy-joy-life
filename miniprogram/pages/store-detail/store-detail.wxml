<!--门店详情页-->
<view class="container detail-page">
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">门店详情</text>
  </view>

  <!-- 页面加载骨架屏 -->
  <view class="page-loading" wx:if="{{pageLoading}}">
    <view class="skeleton-hero"></view>
    <view class="skeleton-card">
      <view class="skeleton-line long"></view>
      <view class="skeleton-line medium"></view>
      <view class="skeleton-line short"></view>
    </view>
    <view class="skeleton-card">
      <view class="skeleton-line long"></view>
      <view class="skeleton-line medium"></view>
    </view>
  </view>

  <view class="hero-card" wx:if="{{!pageLoading}}">
    <swiper class="store-swiper" indicator-dots="{{false}}" circular="{{true}}">
      <swiper-item wx:for="{{store.images}}" wx:key="*this">
        <image class="store-cover" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
    <view class="image-count">1/{{store.images.length || 1}}</view>
  </view>

  <view class="store-card" wx:if="{{!pageLoading}}">
    <view class="store-title-row">
      <view class="store-title-block">
        <text class="store-name">{{store.name || '门店信息待同步'}}</text>
        <text class="type-tag">{{store.categoryTitle || serviceMeta.categoryTitle}}</text>
      </view>
      <view class="distance-block">
        <image src="/images/导航.png" mode="aspectFit"></image>
        <text>{{store.distance || ''}}</text>
      </view>
    </view>
    <view class="address-row">
      <image src="/images/定位.png" mode="aspectFit"></image>
      <text>{{store.address || '门店地址待同步'}}</text>
    </view>
    <view class="store-tags" wx:if="{{store.displayTags && store.displayTags.length}}">
      <text wx:for="{{store.displayTags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="action-row">
      <view class="action-btn" bindtap="openMap">
        <image src="/images/导航.png" mode="aspectFit"></image>
        <text>导航</text>
      </view>
      <view class="action-btn" bindtap="callStore">
        <image src="/images/电话.png" mode="aspectFit"></image>
        <text>电话</text>
      </view>
      <view class="action-btn favorite-action {{isFavorited ? 'active' : ''}}" bindtap="toggleFavorite">
        <image src="/images/门店.png" mode="aspectFit"></image>
        <text>{{isFavorited ? '已收藏' : '收藏'}}</text>
      </view>
      <view class="action-btn" bindtap="contactService">
        <image src="/images/联系客服.png" mode="aspectFit"></image>
        <text>联系客服</text>
      </view>
    </view>
    <view class="asset-row">
      <view class="asset-item" bindtap="goToRecharge">
        <image src="/images/店内余额.png" mode="aspectFit"></image>
        <view>
          <text class="asset-label">店内余额</text>
          <text class="asset-value">¥{{walletBalance || '0.00'}}</text>
        </view>
      </view>
      <view class="asset-divider"></view>
      <view class="asset-item">
        <image src="/images/积分.png" mode="aspectFit"></image>
        <view>
          <text class="asset-label">积分</text>
          <text class="asset-value">{{userPoints || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="booking-notice-bar" wx:if="{{!pageLoading && !bookingEnabled}}">
    <text class="booking-notice-icon">ℹ</text>
    <text class="booking-notice-text">该门店暂不支持在线预约，欢迎到店使用</text>
  </view>

  <view class="panel room-panel" wx:if="{{!pageLoading}}">
    <view class="panel-heading">
      <view class="panel-heading-main">
        <view class="panel-title room-panel-title">{{serviceMeta.resourcePanelTitle}}</view>
      </view>
      <view class="selected-room-pill" wx:if="{{selectedRoom.id}}">
        <text>已选</text>
        <text class="selected-room-name">{{selectedRoom.name}}</text>
      </view>
    </view>
    <scroll-view scroll-x class="room-scroll">
      <view class="room-list">
        <view class="room-card {{item.selected ? 'active' : ''}} {{!item.bookable ? 'disabled' : ''}}" wx:for="{{rooms}}" wx:key="id" bindtap="viewRoomDetail" data-index="{{index}}">
          <view class="room-cover-wrap">
            <image class="room-img" src="{{item.image}}" mode="aspectFill"></image>
            <text class="room-status-badge {{item.statusClass}}">{{item.statusText}}</text>
            <text class="room-selected-mark" wx:if="{{item.selected}}">✓</text>
          </view>
          <view class="room-info">
            <view class="room-name-row">
              <text class="room-name">{{item.name}}</text>
              <text class="room-detail-entry">详情›</text>
            </view>
            <view class="room-meta-line">
              <text wx:if="{{item.metaText}}">{{item.metaText}}</text>
              <text wx:if="{{item.shortDesc}}">{{item.shortDesc}}</text>
            </view>
          </view>
          <view class="room-bottom">
            <view class="room-price-wrap">
              <text class="room-price">¥{{item.priceText}}</text>
              <text class="room-unit">{{item.priceUnitText || serviceMeta.priceUnitText}}</text>
            </view>
            <view class="room-select-btn {{item.selected ? 'selected' : ''}} {{!item.bookable ? 'disabled' : ''}}" catchtap="chooseRoomDirect" data-index="{{index}}">
              {{!item.bookable ? (flowText.disabledText || '不可用') : (item.selected ? '已选' : '选择')}}
            </view>
          </view>
        </view>
        <view class="room-empty" wx:if="{{rooms.length === 0}}">{{serviceMeta.emptyResourceText}}</view>
      </view>
    </scroll-view>
    <view class="more-room" wx:if="{{rooms.length > 0}}" bindtap="goSelectRoom">
      <text>查看更多{{serviceMeta.resourceLabel || '资源'}}</text>
      <text class="more-room-arrow">›</text>
    </view>
  </view>

  <view class="panel" wx:if="{{selectedRoom.id}}">
    <view class="method-header">
      <view class="panel-title method-title">{{flowText.methodTitle || '选择使用方式'}}</view>
      <view class="method-intro-scroll" wx:if="{{selectedPackageIntro}}">
        <view class="method-intro-track">
          <text class="method-intro">{{selectedPackageIntro}}</text>
        </view>
      </view>
    </view>
    <view class="method-grid">
      <view class="method-card {{selectedPackageIdx === index ? 'active' : ''}}" wx:for="{{bookingPackages}}" wx:key="name" bindtap="selectBookingMethod" data-index="{{index}}">
        <text class="method-check" wx:if="{{selectedPackageIdx === index}}">✓</text>
        <text class="method-name">{{item.name}}</text>
        <view>
          <text class="method-price">¥{{item.price}}</text>
          <text class="method-desc"> /{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="panel date-panel" wx:if="{{selectedRoom.id}}">
    <view class="date-header-row">
      <view class="panel-title date-title">{{flowText.dateTitle || '到店使用日期'}}</view>
      <view class="booking-date-tabs date-tabs-inline">
        <view
          class="booking-date-tab {{selectedDate === item.value ? 'active' : ''}}"
          wx:for="{{dates}}"
          wx:key="value"
          bindtap="selectDate"
          data-date="{{item.value}}"
        >
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <view class="booking-entry" wx:if="{{bookingEnabled && selectedRoom.id}}" bindtap="goBookingPage">
    <view>
      <text class="booking-entry-title">预订页面</text>
      <text class="booking-entry-sub">该门店已开启预订功能，可提前填写预订信息</text>
    </view>
    <text class="booking-entry-action">进入</text>
  </view>

  <view class="panel" wx:if="{{selectedRoom.id}}">
    <view class="panel-title">{{flowText.timeTitle || '选择使用时间'}}</view>
    <view class="time-grid" wx:if="{{displayStartTimeOptions.length}}">
      <view
        class="time-chip {{startHour === item.hour ? 'active' : ''}}"
        wx:for="{{displayStartTimeOptions}}"
        wx:key="hour"
        bindtap="selectStartTime"
        data-hour="{{item.hour}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
    <view class="expand-line" wx:if="{{startTimeHasMore}}" bindtap="toggleStartTimeExpand">
      {{showAllStartTimes ? '收起时间' : '选择更多时间'}}
    </view>
    <view class="time-empty" wx:if="{{!displayStartTimeOptions.length}}">
      <text>{{timeOptionsEmptyText}}</text>
      <text class="time-empty-hint" wx:if="{{dates.length > 1}}">试试切换其他日期</text>
    </view>

    <view class="duration-row">
      <view class="panel-title small">{{bookingMode == 'package' ? '套餐时长' : '选择时长'}}</view>
      <text class="end-time">结束时间 {{endTimeStr || '--:--'}}</text>
    </view>
    <view wx:if="{{bookingMode == 'package'}}" class="package-duration-note">
      <text>当前套餐时长 {{selectedHours || 0}} 小时</text>
      <text>选择开始时间后自动计算结束时间</text>
    </view>
    <block wx:else>
      <view class="duration-grid">
        <view class="duration-chip {{selectedHours === item.hours ? 'active' : ''}}" wx:for="{{displayDurationOptions}}" wx:key="hours" bindtap="selectDurationHours" data-hours="{{item.hours}}">
          {{item.label}}
        </view>
      </view>
      <view class="expand-line" wx:if="{{durationHasMore}}" bindtap="toggleDurationExpand">
        {{showAllDurations ? '收起时长' : '选择更多时长'}}
      </view>
    </block>
  </view>

  <view class="panel intro-panel" wx:if="{{!pageLoading}}">
    <view class="panel-title">门店介绍</view>
    <text class="intro-text">{{store.description || '门店介绍待同步'}}</text>
    <view class="intro-tags" wx:if="{{store.displayTags && store.displayTags.length}}">
      <text wx:for="{{store.displayTags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="panel notice-panel" wx:if="{{!pageLoading}}">
    <view class="panel-title">{{flowText.noticeTitle || '到店下单须知'}}</view>
    <text>· {{flowText.noticeSelectText}}</text>
    <text>· {{flowText.noticeUse || '支付成功后可自助使用，请在有效时间内完成支付。'}}</text>
    <text>· 订单超时未支付，系统将自动释放资源。</text>
  </view>

  <!-- 所有房间不可用时的引导 -->
  <view class="panel all-unavailable-panel" wx:if="{{!pageLoading && rooms.length > 0 && !selectedRoom.id}}">
    <text class="all-unavailable-text">当前所有{{serviceMeta.resourceLabel || '资源'}}暂不可用</text>
    <text class="all-unavailable-hint">可稍后再试，或联系客服了解详情</text>
    <view class="all-unavailable-action" bindtap="contactService">联系客服</view>
  </view>

  <view class="bottom-bar" wx:if="{{selectedRoom.id}}">
    <view class="price-summary">
      <view>
        <text>预计 </text>
        <text class="price">¥{{totalPrice || 0}}</text>
      </view>
      <text class="summary-text">{{selectedRoom.name || serviceMeta.resourceLabel}} · {{selectedDateLabel || '今天'}} {{startTimeStr || '--:--'}}-{{endTimeStr || '--:--'}} · {{selectedHours || 0}}小时</text>
      <text class="summary-text">{{selectedPackageName}}</text>
    </view>
    <view class="bottom-actions">
      <button class="recharge-btn" bindtap="goToRecharge">充值优惠</button>
      <button class="confirm-btn" bindtap="confirmBooking">{{flowText.confirmButton || '确认下单并支付'}}</button>
    </view>
  </view>
</view>

<!-- 下单支付确认弹窗 -->
<view class="confirm-mask" wx:if="{{showConfirmModal}}" catchtap="closeConfirmModal"></view>
<view class="confirm-modal" wx:if="{{showConfirmModal}}" catchtap="noop">
  <view class="confirm-close" bindtap="closeConfirmModal">×</view>
  <view class="confirm-head">
    <image class="confirm-icon" src="/images/预约成功.png" mode="aspectFit"></image>
    <view class="confirm-title-wrap">
      <text class="confirm-title">{{flowText.confirmTitle || '确认下单'}}</text>
      <text class="confirm-subtitle">{{flowText.confirmSubtitle || '请核对以下下单信息，确认无误后继续支付'}}</text>
    </view>
  </view>

  <view class="confirm-table">
    <view class="confirm-row">
      <text class="confirm-label">项目</text>
      <text class="confirm-value">{{confirmInfo.project}}</text>
    </view>
    <view class="confirm-row">
      <text class="confirm-label">门店</text>
      <text class="confirm-value">{{confirmInfo.storeName}}</text>
    </view>
    <view class="confirm-row">
      <text class="confirm-label">资源</text>
      <text class="confirm-value">{{confirmInfo.roomName}}</text>
    </view>
    <view class="confirm-row">
      <text class="confirm-label">{{flowText.methodLabel || '使用方式'}}</text>
      <text class="confirm-value">{{confirmInfo.packageName}}</text>
    </view>
    <view class="confirm-row">
      <text class="confirm-label">{{flowText.dateLabel || '使用日期'}}</text>
      <text class="confirm-value">{{confirmInfo.dateText}}</text>
    </view>
    <view class="confirm-row">
      <text class="confirm-label">时间</text>
      <text class="confirm-value">{{confirmInfo.timeText}}</text>
    </view>
    <view class="confirm-row">
      <text class="confirm-label">时长</text>
      <text class="confirm-value">{{confirmInfo.durationText}}</text>
    </view>
    <view class="confirm-row">
      <text class="confirm-label">联系人</text>
      <text class="confirm-value">{{confirmInfo.contactText}}</text>
    </view>
    <view class="confirm-row amount-row-confirm">
      <text class="confirm-label amount-label">应付金额</text>
      <text class="confirm-amount">¥{{confirmInfo.amount}}</text>
    </view>
  </view>

  <view class="confirm-tip">
    <image src="/images/自助开门.png" mode="aspectFit"></image>
    <text>提交后将锁定所选资源，请在15分钟内完成支付，超时将自动取消并释放资源。</text>
  </view>

  <view class="confirm-actions">
    <button class="confirm-cancel-btn" bindtap="closeConfirmModal">取消</button>
    <button class="confirm-pay-btn" bindtap="confirmAndPay">{{flowText.confirmButton || '确认并支付'}}</button>
  </view>
</view>

<!-- 手机验证弹窗 -->
<view class="phone-mask" wx:if="{{showPhoneModal}}" bindtap="closePhoneModal"></view>
<view class="phone-modal" wx:if="{{showPhoneModal}}">
  <view class="modal-header">
    <text class="modal-title">绑定手机号</text>
    <text class="modal-close" bindtap="closePhoneModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="modal-input-row">
      <input class="modal-input" type="number" placeholder="请输入手机号" value="{{modalPhone}}" bindinput="onModalPhoneInput" maxlength="11" />
    </view>
    <view class="modal-input-row code-row">
      <input class="modal-input code-input" type="number" placeholder="请输入验证码" value="{{modalCode}}" bindinput="onModalCodeInput" maxlength="6" />
      <button class="send-code-btn {{modalCountdown > 0 ? 'disabled' : ''}}" bindtap="sendModalCode" disabled="{{modalCountdown > 0}}">
        {{modalCountdown > 0 ? modalCountdown + 's' : '获取验证码'}}
      </button>
    </view>
  </view>
  <button class="modal-confirm-btn" bindtap="confirmPhone" loading="{{modalLoading}}">确认绑定</button>
</view>
<qx-dialog dialog="{{__qxDialog}}" bind:confirm="__onQxDialogConfirm" bind:cancel="__onQxDialogCancel" />
