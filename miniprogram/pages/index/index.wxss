/* 首页 - 雀胜风格 */
.container { background: #f5f5f5; min-height: 100vh; }

/* 搜索栏 */
.search-bar {
  display: flex; align-items: center; margin: 20rpx; padding: 16rpx 24rpx;
  background: #fff; border-radius: 32rpx; border: 1rpx solid #e8e8e8;
}
.search-icon { width: 32rpx; height: 32rpx; margin-right: 16rpx; opacity: 0.5; }
.search-input { flex: 1; font-size: 28rpx; color: #333; }

/* 品牌Banner */
.brand-banner {
  position: relative; margin: 0 20rpx 20rpx; height: 320rpx;
  border-radius: 16rpx; overflow: hidden;
}
.brand-bg { width: 100%; height: 100%; }
.brand-overlay {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; justify-content: center; align-items: center;
  background: rgba(0,0,0,0.3);
}
.brand-name {
  font-size: 72rpx; font-weight: bold; color: #ff4d4f;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
}
.brand-welcome {
  font-size: 48rpx; font-weight: bold; color: #ff4d4f;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}
.banner-icons {
  position: absolute; top: 20rpx; right: 20rpx; display: flex; gap: 16rpx;
}
.banner-icon-item {
  width: 64rpx; height: 64rpx; background: rgba(255,255,255,0.8);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
}
.banner-icon-img { width: 36rpx; height: 36rpx; }

/* 门店列表 */
.store-list { padding: 0 20rpx; }
.store-card {
  display: flex; background: #fff; border-radius: 16rpx;
  margin-bottom: 20rpx; overflow: hidden;
}
.store-img { width: 200rpx; height: 200rpx; flex-shrink: 0; }
.store-info {
  flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: space-between;
}
.store-name { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.store-address { font-size: 24rpx; color: #999; margin-bottom: 8rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.store-meta { display: flex; justify-content: space-between; align-items: center; }
.store-rooms { font-size: 24rpx; color: #1890ff; }
.store-distance { font-size: 24rpx; color: #999; }

/* 空状态 & 加载 */
.empty-state, .loading-state { text-align: center; padding: 100rpx 0; }
.empty-text, .loading-text { font-size: 28rpx; color: #999; }
