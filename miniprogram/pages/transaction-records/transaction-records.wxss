.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 筛选选项 */
.filter-section {
  background: white;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-tabs {
  display: flex;
  justify-content: center;
}

.filter-tab {
  padding: 16rpx 40rpx;
  margin: 0 10rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.3s;
}

.filter-tab.active {
  background: #1890ff;
  color: white;
}

/* 交易记录列表 */
.records-list {
  padding: 20rpx;
}

.date-group {
  margin-bottom: 30rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: white;
  border-radius: 12rpx 12rpx 0 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.date-summary {
  font-size: 24rpx;
  color: #999;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
  border-radius: 0 0 12rpx 12rpx;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.record-icon image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #f5f5f5;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record-title {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.record-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.record-time {
  font-size: 24rpx;
  color: #999;
}

.record-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.amount {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.amount.income {
  color: #52c41a;
}

.amount.expense {
  color: #ff4d4f;
}

.status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.status.success {
  background: #f6ffed;
  color: #52c41a;
}

.status.pending {
  background: #fff7e6;
  color: #faad14;
}

.status.failed {
  background: #fff2f0;
  color: #ff4d4f;
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
}

.load-btn {
  width: 300rpx;
  height: 80rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 统计信息 */
.statistics {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
}

.stat-value.income {
  color: #52c41a;
}

.stat-value.expense {
  color: #ff4d4f;
}