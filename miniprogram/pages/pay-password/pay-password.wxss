.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

/* 头部 */
.header {
  padding: 40rpx 20rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

/* 表单 */
.form-container {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
}

.form-item {
  margin-bottom: 50rpx;
  position: relative;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 30rpx;
  font-weight: 500;
}

.password-input-container {
  position: relative;
  height: 100rpx;
}

.password-dots {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  position: relative;
  z-index: 1;
  pointer-events: none;
}

.dot {
  flex: 1;
  height: 100rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  position: relative;
}

.dot::after {
  content: '';
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: transparent;
}

.dot.filled::after {
  background: #333;
}

.password-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 2;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 15rpx;
}

.forgot-password {
  position: absolute;
  right: 0;
  top: 0;
  font-size: 26rpx;
  color: #1890ff;
}

/* 按钮 */
.button-container {
  padding: 30rpx 20rpx;
}

.submit-btn {
  width: 100%;
  background: #1890ff;
  color: white;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 32rpx;
  border: none;
}

.submit-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}

/* 温馨提示 */
.tips-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx;
}

.tips-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.tips-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.tips-content {
  display: flex;
  flex-direction: column;
}

.tip-item {
  font-size: 26rpx;
  color: #666;
  line-height: 40rpx;
  margin-bottom: 10rpx;
}
