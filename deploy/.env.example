# 易享生活棋牌室小程序 - 生产环境配置
# 复制此文件为 .env 并填入真实值

# 数据库配置
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_USER_PASSWORD=your_mysql_user_password

# JWT配置
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_for_production

# 微信小程序配置
WECHAT_APPID=your_wechat_miniprogram_appid
WECHAT_SECRET=your_wechat_miniprogram_secret

# 微信支付配置
WECHAT_MCH_ID=your_wechat_merchant_id
WECHAT_API_KEY=your_wechat_payment_api_key

# 服务器域名
SERVER_DOMAIN=https://your-domain.com

# 其他配置
TZ=Asia/Shanghai