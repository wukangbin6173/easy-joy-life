.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f8f7;
}

.cashier-frame {
  flex: 1;
  width: 100%;
}

.cashier-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  box-sizing: border-box;
  text-align: center;
}

.state-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #fff1f0;
  color: #df3b30;
  font-size: 46rpx;
  line-height: 76rpx;
  font-weight: 700;
}

.state-title {
  margin-top: 28rpx;
  color: #16231d;
  font-size: 34rpx;
  font-weight: 600;
}

.state-desc {
  max-width: 620rpx;
  margin-top: 18rpx;
  color: #6b756f;
  font-size: 26rpx;
  line-height: 1.7;
}

.debug-box {
  width: 100%;
  margin-top: 28rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #edf1ee;
  text-align: left;
}

.debug-label {
  display: block;
  color: #88928c;
  font-size: 24rpx;
}

.debug-url {
  display: block;
  margin-top: 8rpx;
  color: #344039;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.state-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.state-secondary,
.state-retry {
  width: 220rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.state-secondary {
  background: #f2f5f3;
  color: #526158;
}

.state-retry {
  background: #08a85c;
  color: #ffffff;
}

.state-secondary::after,
.state-retry::after {
  border: 0;
}
