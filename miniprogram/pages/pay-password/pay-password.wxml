<view class="container">
  <view class="header">
    <text class="title">支付密码</text>
    <text class="subtitle">{{hasPassword ? '修改支付密码' : '设置支付密码'}}</text>
  </view>

  <view class="form-container">
    <!-- 旧密码（仅修改时显示） -->
    <view class="form-item" wx:if="{{hasPassword}}">
      <text class="label">原密码</text>
      <view class="password-input-container">
        <view class="password-dots">
          <view class="dot {{oldPassword.length > 0 ? 'filled' : ''}}"></view>
          <view class="dot {{oldPassword.length > 1 ? 'filled' : ''}}"></view>
          <view class="dot {{oldPassword.length > 2 ? 'filled' : ''}}"></view>
          <view class="dot {{oldPassword.length > 3 ? 'filled' : ''}}"></view>
          <view class="dot {{oldPassword.length > 4 ? 'filled' : ''}}"></view>
          <view class="dot {{oldPassword.length > 5 ? 'filled' : ''}}"></view>
        </view>
        <input class="password-input" type="number" password maxlength="6" value="{{oldPassword}}" bindinput="onOldPasswordInput" focus="{{focusOld}}" />
      </view>
      <text class="forgot-password" bindtap="forgotPassword">忘记密码？</text>
    </view>

    <!-- 新密码 -->
    <view class="form-item">
      <text class="label">{{hasPassword ? '新密码' : '设置密码'}}</text>
      <view class="password-input-container">
        <view class="password-dots">
          <view class="dot {{newPassword.length > 0 ? 'filled' : ''}}"></view>
          <view class="dot {{newPassword.length > 1 ? 'filled' : ''}}"></view>
          <view class="dot {{newPassword.length > 2 ? 'filled' : ''}}"></view>
          <view class="dot {{newPassword.length > 3 ? 'filled' : ''}}"></view>
          <view class="dot {{newPassword.length > 4 ? 'filled' : ''}}"></view>
          <view class="dot {{newPassword.length > 5 ? 'filled' : ''}}"></view>
        </view>
        <input class="password-input" type="number" password maxlength="6" value="{{newPassword}}" bindinput="onNewPasswordInput" focus="{{focusNew}}" />
      </view>
      <text class="hint">请输入6位数字密码</text>
    </view>

    <!-- 确认密码 -->
    <view class="form-item">
      <text class="label">确认密码</text>
      <view class="password-input-container">
        <view class="password-dots">
          <view class="dot {{confirmPassword.length > 0 ? 'filled' : ''}}"></view>
          <view class="dot {{confirmPassword.length > 1 ? 'filled' : ''}}"></view>
          <view class="dot {{confirmPassword.length > 2 ? 'filled' : ''}}"></view>
          <view class="dot {{confirmPassword.length > 3 ? 'filled' : ''}}"></view>
          <view class="dot {{confirmPassword.length > 4 ? 'filled' : ''}}"></view>
          <view class="dot {{confirmPassword.length > 5 ? 'filled' : ''}}"></view>
        </view>
        <input class="password-input" type="number" password maxlength="6" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" focus="{{focusConfirm}}" />
      </view>
    </view>
  </view>

  <view class="button-container">
    <button class="submit-btn" bindtap="submitPassword" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '确认'}}
    </button>
  </view>

  <view class="tips-section">
    <view class="tips-title">
      <image class="tips-icon" src="/images/提示.png"></image>
      <text>安全提示</text>
    </view>
    <view class="tips-content">
      <text class="tip-item">• 支付密码用于提现和支付验证</text>
      <text class="tip-item">• 请设置6位数字密码</text>
      <text class="tip-item">• 请勿使用简单密码（如123456）</text>
      <text class="tip-item">• 请妥善保管您的支付密码</text>
    </view>
  </view>
</view>
<qx-dialog dialog="{{__qxDialog}}" bind:confirm="__onQxDialogConfirm" bind:cancel="__onQxDialogCancel" />
