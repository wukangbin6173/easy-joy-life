<view class="container">
  <view class="order-status">
    <view class="status-icon">
      <image src="/images/status-{{order.status}}.png" mode="aspectFit"></image>
    </view>
    <text class="status-text">{{order.statusText}}</text>
    <text class="status-desc">{{order.statusDesc}}</text>
  </view>

  <view class="order-info">
    <view class="info-item">
      <text class="label">订单号：</text>
      <text class="value">{{order.orderNo}}</text>
    </view>
    <view class="info-item">
      <text class="label">门店：</text>
      <text class="value">{{order.storeName}}</text>
    </view>
    <view class="info-item">
      <text class="label">房间：</text>
      <text class="value">{{order.roomName}}</text>
    </view>
    <view class="info-item">
      <text class="label">预订时间：</text>
      <text class="value">{{order.bookingDate}} {{order.startTime}}-{{order.endTime}}</text>
    </view>
    <view class="info-item">
      <text class="label">联系电话：</text>
      <text class="value">{{order.phone}}</text>
    </view>
    <view class="info-item" wx:if="{{order.remark}}">
      <text class="label">备注：</text>
      <text class="value">{{order.remark}}</text>
    </view>
  </view>

  <view class="price-detail">
    <view class="detail-item">
      <text class="label">房间费用</text>
      <text class="value">¥{{order.roomPrice}}</text>
    </view>
    <view class="detail-item" wx:if="{{order.discount > 0}}">
      <text class="label">优惠金额</text>
      <text class="value discount">-¥{{order.discount}}</text>
    </view>
    <view class="detail-item total">
      <text class="label">实付金额</text>
      <text class="value">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <view class="unlock-info" wx:if="{{order.status === 'using' && order.unlockCode}}">
    <view class="unlock-title">开门密码</view>
    <view class="unlock-code">{{order.unlockCode}}</view>
    <view class="unlock-tip">请在房间门锁上输入此密码开门</view>
  </view>

  <view class="order-actions">
    <button class="action-btn" wx:if="{{order.status === 'pending'}}" bindtap="cancelOrder">
      取消订单
    </button>
    <button class="action-btn primary" wx:if="{{order.status === 'using'}}" bindtap="unlockRoom">
      开门
    </button>
    <button class="action-btn" wx:if="{{order.status === 'completed'}}" bindtap="rateOrder">
      评价
    </button>
    <button class="action-btn" bindtap="contactService">
      联系客服
    </button>
  </view>
</view>