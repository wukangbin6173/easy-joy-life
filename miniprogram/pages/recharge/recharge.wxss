page {
  background: #f8faf9;
}

.recharge-page {
  min-height: 100vh;
  padding: 22rpx 22rpx 170rpx;
  box-sizing: border-box;
  background: #f8faf9;
}

.asset-card {
  min-height: 154rpx;
  padding: 26rpx 22rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(115deg, #0ba85c 0%, #12b96d 58%, #42d993 100%);
  box-shadow: 0 12rpx 30rpx rgba(8, 168, 92, 0.18);
  box-sizing: border-box;
}

.asset-item {
  width: 0;
  flex: 1 1 0;
  text-align: center;
}

.asset-label {
  display: block;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  margin-bottom: 12rpx;
}

.asset-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.asset-currency {
  margin-right: 6rpx;
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
}

.asset-value {
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
}

.asset-divider {
  width: 1rpx;
  height: 84rpx;
  background: rgba(255, 255, 255, 0.22);
}

.panel,
.notice-card {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(20, 43, 31, 0.05);
}

.amount-panel {
  padding: 28rpx 24rpx 26rpx;
}

.panel-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.panel-title {
  color: #18221d;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
}

.panel-subtitle {
  margin-top: 8rpx;
  color: #8a948f;
  font-size: 22rpx;
  line-height: 1.3;
}

.amount-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.amount-item {
  height: 88rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e9eeeb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #26302a;
  background: #fff;
  box-sizing: border-box;
}

.amount-item.selected {
  color: #08A85C;
  border-color: #08A85C;
  background: #f1fbf6;
  box-shadow: 0 8rpx 18rpx rgba(8, 168, 92, 0.08);
}

.amount-symbol {
  margin-right: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.amount-text {
  font-size: 31rpx;
  font-weight: 600;
}

.amount-item.selected .amount-symbol,
.amount-item.selected .amount-text {
  font-weight: 800;
}

.custom-amount {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf0ee;
}

.custom-label {
  display: block;
  margin-bottom: 14rpx;
  color: #5f6964;
  font-size: 24rpx;
}

.input-wrapper {
  height: 78rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid #edf0ee;
  display: flex;
  align-items: center;
  background: #fafbfa;
  box-sizing: border-box;
}

.input-wrapper.active {
  border-color: #08A85C;
  background: #f8fffb;
}

.currency {
  margin-right: 10rpx;
  color: #87918b;
  font-size: 30rpx;
  font-weight: 600;
}

.amount-input {
  flex: 1;
  height: 78rpx;
  color: #18221d;
  font-size: 28rpx;
  font-weight: 600;
}

.notice-card {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  background: #f0fbf6;
}

.notice-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #fff;
}

.notice-icon image {
  width: 40rpx;
  height: 40rpx;
}

.notice-content {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.notice-title {
  color: #25302a;
  font-size: 26rpx;
  font-weight: 700;
}

.notice-text {
  margin-top: 8rpx;
  color: #68766e;
  font-size: 22rpx;
  line-height: 1.4;
}

.recharge-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  min-height: 122rpx;
  padding: 20rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(20, 43, 31, 0.08);
  box-sizing: border-box;
}

.footer-amount {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.footer-label {
  color: #77847d;
  font-size: 22rpx;
}

.footer-price {
  margin-top: 4rpx;
  color: #e67c22;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.recharge-btn {
  width: 300rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a7afab;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
  background: #f1f3f2;
}

.recharge-btn.active {
  color: #fff;
  background: linear-gradient(135deg, #12b96d 0%, #07984d 100%);
  box-shadow: 0 10rpx 22rpx rgba(8, 168, 92, 0.22);
}

.recharge-btn::after {
  border: none;
}

.phone-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.5);
}

.phone-modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  z-index: 201;
  transform: translateY(-50%);
  padding: 40rpx;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.modal-title {
  color: #17211c;
  font-size: 34rpx;
  font-weight: 800;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  color: #8a948f;
  font-size: 40rpx;
  line-height: 48rpx;
  text-align: center;
}

.modal-body {
  margin-bottom: 30rpx;
}

.modal-input-row {
  margin-bottom: 22rpx;
}

.modal-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  color: #18221d;
  font-size: 28rpx;
  background: #f7f8f7;
  box-sizing: border-box;
}

.code-row {
  display: flex;
  gap: 16rpx;
}

.code-input {
  flex: 1;
  width: auto;
}

.send-code-btn {
  width: 202rpx;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 82rpx;
  background: #08A85C;
  flex-shrink: 0;
}

.send-code-btn.disabled {
  color: #9aa39f;
  background: #eef1ef;
}

.send-code-btn::after,
.modal-confirm-btn::after {
  border: none;
}

.modal-confirm-btn {
  width: 100%;
  height: 86rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 86rpx;
  background: #08A85C;
}
